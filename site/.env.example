# Скопировать в .env и заполнить. .env в git не попадает.
DEBUG=True
# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Токен для 1С (заголовок Authorization: Token <значение>). В 1С задаётся командой «Задать токен обмена»
EXCHANGE_TOKEN=change-me
# ALLOWED_HOSTS=localhost,127.0.0.1,хозтрейд.рф
# Сайт в интернете за TLS: secure-cookie, HSTS, редирект на https
# HTTPS=True
# Фото и файлы заявок раздаёт Django; за nginx — False и раздавать site/media веб-сервером
# SERVE_MEDIA=True
# DATABASE_URL=postgres://hoztrade:pass@localhost:5432/hoztrade
# MANAGER_EMAILS=manager@example.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Уведомления менеджерам в Telegram: токен бота от @BotFather и ID чата, куда добавлен бот
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-1001234567890
