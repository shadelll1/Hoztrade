# Сайт в интернете с этого компьютера: site\run-public.bat + deploy\windows\run-caddy.bat (docs/deploy.md).
# Скопировать в .env.public (в git не попадает) и заполнить. Чего здесь нет — берётся из .env (SECRET_KEY, токен).
# Этот же файл читает Caddy (SITE_DOMAIN, MEDIA_DIR).

DEBUG=False
HTTPS=True
# Домен — в punycode (так его присылает браузер): https://www.punycoder.com или python -c "print('сайт.рф'.encode('idna'))"
SITE_DOMAIN=xn--d1abfjwnnv.xn--p1ai
ALLOWED_HOSTS=xn--d1abfjwnnv.xn--p1ai
CSRF_TRUSTED_ORIGINS=https://xn--d1abfjwnnv.xn--p1ai
# Адрес в ссылках из писем
SITE_URL=https://хозтрейд.рф
# Фото товаров раздаёт Caddy с диска; папку leads/ (файлы заявок) он не отдаёт
SERVE_MEDIA=False
MEDIA_DIR=C:/Dev/Hoztrade/site/media
LOG_DIR=logs

# Почта mail.ru: пароль — не от ящика, а «пароль для внешних приложений» (Настройки → Безопасность).
# @ в логине — %40; в пароле @ : / тоже заменить на %40 %3A %2F.
EMAIL_URL=smtp+ssl://shop%40mail.ru:ПАРОЛЬ_ПРИЛОЖЕНИЯ@smtp.mail.ru:465
# mail.ru отправляет только от имени самого ящика
DEFAULT_FROM_EMAIL=shop@mail.ru
MANAGER_EMAILS=shop@mail.ru
ADMIN_EMAILS=shop@mail.ru
