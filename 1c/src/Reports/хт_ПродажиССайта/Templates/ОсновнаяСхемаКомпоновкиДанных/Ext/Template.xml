		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Заказы.Ссылка КАК Заказ,
	НАЧАЛОПЕРИОДА(Заказы.Дата, ДЕНЬ) КАК День,
	ОбъектыСайта.НомерНаСайте КАК НомерНаСайте,
	Заказы.Контрагент КАК Покупатель,
	ВЫБОР
		КОГДА Заказы.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ФизическоеЛицо)
			ТОГДА "Частное лицо"
		ИНАЧЕ "Организация или ИП"
	КОНЕЦ КАК ТипПокупателя,
	Заказы.СостояниеЗаказа КАК Состояние,
	ВЫБОР
		КОГДА Заказы.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.Курьер)
			ТОГДА "Доставка грузотакси"
		ИНАЧЕ "Самовывоз"
	КОНЕЦ КАК Получение,
	Заказы.ЗонаТариф КАК Зона,
	Заказы.ВидЦен КАК ВидЦен,
	1 КАК Заказов,
	Заказы.СуммаДокумента КАК Сумма,
	Заказы.СтоимостьДоставки КАК Доставка,
	Заказы.Вес КАК Вес
ИЗ
	РегистрСведений.хт_ОбъектыСайта КАК ОбъектыСайта
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказы
		ПО ОбъектыСайта.Объект = Заказы.Ссылка
ГДЕ
	ОбъектыСайта.ВидОбъекта = "order"
	И Заказы.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И НЕ Заказы.ПометкаУдаления</query>
