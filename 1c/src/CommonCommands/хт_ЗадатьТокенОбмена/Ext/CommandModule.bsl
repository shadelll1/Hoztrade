&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если Не ЗначениеЗаполнено(ПараметрКоманды) Тогда
		ПоказатьПредупреждение(, "Сначала запишите настройку обмена.");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаТокена", ЭтотОбъект, ПараметрКоманды);
	ПоказатьВводСтроки(Оповещение, "", "Токен обмена (EXCHANGE_TOKEN из site\.env)", 100, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаТокена(Токен, Настройка) Экспорт
	
	Если Токен = Неопределено Тогда
		Возврат;
	КонецЕсли;
	хт_ОбменССайтомВызовСервера.ЗадатьТокенОбмена(Настройка, Токен);
	Если ЗначениеЗаполнено(СокрЛП(Токен)) Тогда
		ПоказатьОповещениеПользователя("Токен обмена сохранён", , "Проверьте связь с сайтом");
	Иначе
		ПоказатьОповещениеПользователя("Токен обмена удалён");
	КонецЕсли;
	
КонецПроцедуры
