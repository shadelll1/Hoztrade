&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Папка с картинками товаров (имя файла — артикул)";
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораПапки", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПапки(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОЗамене", ЭтотОбъект, ВыбранныеФайлы[0]),
		"Заменить картинки и у товаров, где они уже есть?", РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОЗамене(Ответ, Каталог) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	Состояние("Загрузка картинок товаров...");
	Итог = хт_ОбменССайтомВызовСервера.ЗагрузитьКартинкиТоваров(Каталог, Ответ = КодВозвратаДиалога.Да);
	ПоказатьПредупреждение(, Итог);
	
КонецПроцедуры
