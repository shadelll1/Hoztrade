#Область ПрограммныйИнтерфейс

// Заполняет базу демо-каталогом «Хозтрейда» из общего макета хт_ДемоКаталог: группы и товары
// номенклатуры, розничные и оптовые цены, остатки (документ «Оприходование запасов») и настройку
// обмена с сайтом на localhost. Повторный запуск обновляет данные, а не дублирует их.
//
// Возвращаемое значение:
//  Строка - итог для показа пользователю.
//
Функция ЗаполнитьДемоКаталог() Экспорт

	Данные = ПрочитатьМакет();
	// В демо-базе предопределённый вид цен «Оптовая» переименован в «Розничная», поэтому ищем по наименованию
	// и следим, чтобы розница и опт были разными видами цен.
	ВидЦенРозница = ВидЦен("Розничная", Справочники.ВидыЦен.ПустаяСсылка());
	ВидЦенОпт = ВидЦен("Оптовая", ВидЦенРозница);

	Создано = 0;
	Всего = 0;
	КорневыеГруппы = Новый Массив;
	СтрокиОстатков = Новый Массив;

	НачатьТранзакцию();
	Попытка
		Для Каждого Раздел Из Данные Цикл
			ГруппаРаздела = Группа(Раздел["name"], Справочники.Номенклатура.ПустаяСсылка());
			КорневыеГруппы.Добавить(ГруппаРаздела);

			Для Каждого Подраздел Из Раздел["groups"] Цикл
				ГруппаПодраздела = Группа(Подраздел["name"], ГруппаРаздела);

				Для Каждого ДанныеТовара Из Подраздел["items"] Цикл
					Товар = Товар(ДанныеТовара, ГруппаПодраздела);
					Всего = Всего + 1;
					Создано = Создано + ?(Товар.Создан, 1, 0);

					УстановитьЦену(Товар.Ссылка, ВидЦенРозница, ДанныеТовара["retail"], Товар.ЕдиницаИзмерения);
					УстановитьЦену(Товар.Ссылка, ВидЦенОпт, ДанныеТовара["wholesale"], Товар.ЕдиницаИзмерения);

					Если ДанныеТовара["qty"] > 0 Тогда
						СтрокиОстатков.Добавить(Новый Структура("Номенклатура, ЕдиницаИзмерения, Количество, Цена",
							Товар.Ссылка, Товар.ЕдиницаИзмерения, ДанныеТовара["qty"],
							Окр(ДанныеТовара["wholesale"] * 0.8, 2)));
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;

		Склад = ЗаписатьОстатки(СтрокиОстатков);
		Настройка = НастройкаОбмена(КорневыеГруппы, Склад, ВидЦенРозница, ВидЦенОпт);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Итог = СтрШаблон("Демо-каталог Хозтрейд: товаров %1 (новых %2), разделов %3.
		|Цены установлены, остатки оприходованы на склад ""%4"".
		|Настройка обмена: ""%5"".",
		Всего, Создано, КорневыеГруппы.Количество(), Склад, Настройка);
	Если Не ЗначениеЗаполнено(Настройка.ТокенОбмена) Тогда
		Итог = Итог + Символы.ПС
			+ "Заполните в настройке токен обмена (EXCHANGE_TOKEN из site\.env) и проверьте связь с сайтом.";
	КонецЕсли;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьМакет()

	Текст = ПолучитьОбщийМакет("хт_ДемоКаталог").ПолучитьТекст();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();
	Возврат Данные;

КонецФункции

#Область Номенклатура

Функция Группа(Наименование, Родитель)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Родитель", Родитель);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа
	|	И Номенклатура.Наименование = &Наименование
	|	И Номенклатура.Родитель = &Родитель
	|	И НЕ Номенклатура.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Объект = Справочники.Номенклатура.СоздатьГруппу();
	Объект.Наименование = Наименование;
	Объект.Родитель = Родитель;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция Товар(Данные, Родитель)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Артикул", Данные["sku"]);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И Номенклатура.Артикул = &Артикул
	|	И НЕ Номенклатура.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();

	Создан = Не Выборка.Следующий();
	Если Создан Тогда
		// Как в штатной интеграции УНФ с интернет-магазином (ИнтеграцияСИнтернетМагазиномСервер).
		Объект = Справочники.Номенклатура.СоздатьЭлемент();
		Объект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
		Объект.Артикул = Данные["sku"];
		Объект.КатегорияНоменклатуры = Справочники.КатегорииНоменклатуры.БезКатегории;
		Объект.ЕдиницаИзмерения = ЕдиницаИзмерения(Данные["unit"]);
		Объект.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Общая;
		Объект.МетодОценки = Перечисления.МетодОценкиЗапасов.ПоСредней;
		Объект.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ОсновноеНаправление;
		Объект.Склад = Справочники.СтруктурныеЕдиницы.ОсновнойСклад;
		Объект.СпособПополнения = Перечисления.СпособыПополненияЗапасов.Закупка;
		Объект.СчетУчетаЗатрат = ПланыСчетов.Управленческий.НезавершенноеПроизводство;
		Объект.СчетУчетаЗапасов = Справочники.Номенклатура.СчетУчетаЗапасов();
		Объект.СрокПополнения = 1;
		Объект.СрокИсполненияЗаказа = 1;
		Объект.ДополнительныеСвойства.Вставить("ОтключитьЗаполнениеСловаряСопоставленияНоменклатурыБЭД", Истина);
		Объект.Заполнить(Неопределено);
	Иначе
		Объект = Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Объект.Родитель = Родитель;
	Объект.Наименование = Данные["name"];
	Объект.НаименованиеПолное = Данные["name"];
	Объект.Вес = Данные["weight"];
	Объект.Объем = Данные["volume"];
	Если Создан Или Объект.Модифицированность() Тогда
		Объект.Записать();
	КонецЕсли;

	Возврат Новый Структура("Ссылка, ЕдиницаИзмерения, Создан", Объект.Ссылка, Объект.ЕдиницаИзмерения, Создан);

КонецФункции

Функция ЕдиницаИзмерения(Наименование)

	Если Наименование = "шт" Тогда
		Возврат Справочники.КлассификаторЕдиницИзмерения.шт;
	КонецЕсли;

	Ссылка = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	// Коды по ОКЕИ; у мешка и ведра кода в ОКЕИ нет, им даны свои.
	Описание = Новый Соответствие;
	Описание.Вставить("кг", "166;Килограмм");
	Описание.Вставить("м²", "055;Квадратный метр");
	Описание.Вставить("лист", "625;Лист");
	Описание.Вставить("рулон", "736;Рулон");
	Описание.Вставить("упак", "778;Упаковка");
	Описание.Вставить("мешок", "9901;Мешок");
	Описание.Вставить("ведро", "9902;Ведро");

	Части = СтрРазделить(?(Описание[Наименование] = Неопределено, ";" + Наименование, Описание[Наименование]), ";");
	Код = Части[0];

	Если ЗначениеЗаполнено(Код) Тогда
		Ссылка = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(Код);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;

	Объект = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
	Объект.Код = Код;
	Объект.Наименование = Наименование;
	Объект.НаименованиеПолное = Части[1];
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

#КонецОбласти

#Область ЦеныИОстатки

Функция ВидЦен(Наименование, Исключая)

	Ссылка = Справочники.ВидыЦен.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) И Ссылка <> Исключая Тогда
		Возврат Ссылка;
	КонецЕсли;

	Объект = Справочники.ВидыЦен.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);
	Объект.Наименование = Наименование;
	Если Не ЗначениеЗаполнено(Объект.ВалютаЦены) Тогда
		Объект.ВалютаЦены = Константы.НациональнаяВалюта.Получить();
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Процедура УстановитьЦену(Номенклатура, ВидЦен, Цена, ЕдиницаИзмерения)

	Если Не ЗначениеЗаполнено(Цена) Тогда
		Возврат;
	КонецЕсли;

	Валюта = ВидЦен.ВалютаЦены;
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Константы.НациональнаяВалюта.Получить();
	КонецЕсли;

	// Период - начало дня: повторный запуск в тот же день перезаписывает цену, а не добавляет новую.
	Запись = РегистрыСведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
	Запись.Период = НачалоДня(ТекущаяДатаСеанса());
	Запись.ВидЦен = ВидЦен;
	Запись.Номенклатура = Номенклатура;
	Запись.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Запись.Цена = Цена;
	Запись.ЕдиницаИзмерения = ЕдиницаИзмерения;
	Запись.ВалютаЦены = Валюта;
	Запись.Актуальность = Истина;
	Запись.Записать(Истина);

КонецПроцедуры

Функция ЗаписатьОстатки(Строки)

	Комментарий = "Демо-каталог Хозтрейд: начальные остатки";

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Комментарий", Комментарий);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Оприходование.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОприходованиеЗапасов КАК Оприходование
	|ГДЕ
	|	Оприходование.Комментарий ПОДОБНО &Комментарий
	|	И НЕ Оприходование.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Документ = Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		Документ = Документы.ОприходованиеЗапасов.СоздатьДокумент();
		Документ.Дата = ТекущаяДатаСеанса();
		Документ.Заполнить(Неопределено);
		Документ.Комментарий = Комментарий;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Документ.Организация) Тогда
		Документ.Организация = Справочники.Организации.ОсновнаяОрганизация;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Документ.СтруктурнаяЕдиница) Тогда
		Документ.СтруктурнаяЕдиница = Справочники.СтруктурныеЕдиницы.ОсновнойСклад;
	КонецЕсли;

	Документ.Запасы.Очистить();
	Для Каждого Строка Из Строки Цикл
		НоваяСтрока = Документ.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Сумма = Строка.Количество * Строка.Цена;
	КонецЦикла;
	Документ.СуммаДокумента = Документ.Запасы.Итог("Сумма");

	Документ.Записать(РежимЗаписиДокумента.Проведение);

	Возврат Документ.СтруктурнаяЕдиница;

КонецФункции

#КонецОбласти

#Область НастройкаОбмена

Функция НастройкаОбмена(КорневыеГруппы, Склад, ВидЦенРозница, ВидЦенОпт)

	Наименование = "Сайт Хозтрейд (localhost)";
	Ссылка = Справочники.хт_НастройкиОбменаССайтом.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.хт_НастройкиОбменаССайтом.СоздатьЭлемент();
		Объект.Наименование = Наименование;
		Объект.АдресСайта = "http://localhost:8000";
		Объект.ТаймаутСекунд = 60;
	КонецЕсли;

	Объект.ВидЦенРозница = ВидЦенРозница;
	Объект.ВидЦенОпт = ВидЦенОпт;
	Объект.Используется = Истина;

	Объект.ГруппыНоменклатуры.Очистить();
	Для Каждого Группа Из КорневыеГруппы Цикл
		Объект.ГруппыНоменклатуры.Добавить().Группа = Группа;
	КонецЦикла;
	Объект.Склады.Очистить();
	Объект.Склады.Добавить().Склад = Склад;

	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

#КонецОбласти

#КонецОбласти
