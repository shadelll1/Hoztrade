#Область ПрограммныйИнтерфейс

// Загружает с сайта новые заказы: создаёт контрагентов и документы «Заказ покупателя», подтверждает
// сайту получение. Повторная загрузка того же заказа не создаёт дубль (регистр хт_ОбъектыСайта).
//
// Параметры:
//  Настройка - СправочникСсылка.хт_НастройкиОбменаССайтом - настройка обмена.
//
// Возвращаемое значение:
//  Структура:
//   * Успешно  - Булево - обмен прошёл без ошибок.
//   * Получено - Число - сколько заказов получено с сайта.
//   * Описание - Строка - итог или текст ошибки.
//
Функция ЗагрузитьЗаказы(Настройка) Экспорт

	Результат = Новый Структура("Успешно, Получено, Описание", Ложь, 0, "");
	Попытка
		Ответ = хт_ОбменССайтом.ВыполнитьЗапросКСайту(Настройка, "GET", "/api/v1/orders/new/");
		Если Не Ответ.Успешно Тогда
			ВызватьИсключение Ответ.Описание;
		КонецЕсли;

		Заказы = Ответ.Данные["orders"];
		Результат.Получено = Заказы.Количество();
		Подтверждения = Новый Массив;
		Ошибки = Новый Массив;
		Создано = 0;

		Для Каждого ДанныеЗаказа Из Заказы Цикл
			Попытка
				Загруженный = ЗагруженныйОбъект(Настройка, "order", ДанныеЗаказа["id"]);
				Если Загруженный = Неопределено Тогда
					Загруженный = СоздатьЗаказПокупателя(Настройка, ДанныеЗаказа);
					Создано = Создано + 1;
				КонецЕсли;
				Подтверждения.Добавить(Подтверждение(ДанныеЗаказа["id"], Загруженный));
			Исключение
				Ошибки.Добавить(СтрШаблон("заказ %1: %2", ДанныеЗаказа["number"],
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
		КонецЦикла;

		ПодтвердитьПолучение(Настройка, "/api/v1/orders/ack/", "orders", Подтверждения);

		Результат.Успешно = Ошибки.Количество() = 0;
		Результат.Описание = СтрШаблон("заказов получено %1, создано %2", Заказы.Количество(), Создано)
			+ ?(Ошибки.Количество() = 0, "", "; ошибки: " + СтрСоединить(Ошибки, "; "));
	Исключение
		Результат.Описание = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	хт_ОбменССайтом.ЗаписатьВЖурналОбмена(Настройка, "Загрузка заказов", Результат.Успешно, 0,
		Результат.Получено, Результат.Описание);
	Возврат Результат;

КонецФункции

// Загружает с сайта новые заявки (обратный звонок, заказ по списку) в справочник «Лиды»,
// прикладывает к лиду файл сметы, подтверждает сайту получение.
//
// Параметры:
//  Настройка - СправочникСсылка.хт_НастройкиОбменаССайтом - настройка обмена.
//
// Возвращаемое значение:
//  Структура - как у ЗагрузитьЗаказы.
//
Функция ЗагрузитьЗаявки(Настройка) Экспорт

	Результат = Новый Структура("Успешно, Получено, Описание", Ложь, 0, "");
	Попытка
		Ответ = хт_ОбменССайтом.ВыполнитьЗапросКСайту(Настройка, "GET", "/api/v1/leads/new/");
		Если Не Ответ.Успешно Тогда
			ВызватьИсключение Ответ.Описание;
		КонецЕсли;

		Заявки = Ответ.Данные["leads"];
		Результат.Получено = Заявки.Количество();
		Подтверждения = Новый Массив;
		Ошибки = Новый Массив;
		Создано = 0;

		Для Каждого ДанныеЗаявки Из Заявки Цикл
			Попытка
				Загруженный = ЗагруженныйОбъект(Настройка, "lead", ДанныеЗаявки["id"]);
				Если Загруженный = Неопределено Тогда
					Загруженный = СоздатьЛид(Настройка, ДанныеЗаявки);
					Создано = Создано + 1;
				КонецЕсли;
				Подтверждения.Добавить(Подтверждение(ДанныеЗаявки["id"], Загруженный));
			Исключение
				Ошибки.Добавить(СтрШаблон("заявка %1: %2", ДанныеЗаявки["id"],
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
		КонецЦикла;

		ПодтвердитьПолучение(Настройка, "/api/v1/leads/ack/", "leads", Подтверждения);

		Результат.Успешно = Ошибки.Количество() = 0;
		Результат.Описание = СтрШаблон("заявок получено %1, создано лидов %2", Заявки.Количество(), Создано)
			+ ?(Ошибки.Количество() = 0, "", "; ошибки: " + СтрСоединить(Ошибки, "; "));
	Исключение
		Результат.Описание = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	хт_ОбменССайтом.ЗаписатьВЖурналОбмена(Настройка, "Загрузка заявок", Результат.Успешно, 0,
		Результат.Получено, Результат.Описание);
	Возврат Результат;

КонецФункции

// Отправляет на сайт статусы и итоговые суммы заказов, загруженных с сайта, если они изменились
// с прошлой отправки.
//
// Параметры:
//  Настройка - СправочникСсылка.хт_НастройкиОбменаССайтом - настройка обмена.
//
// Возвращаемое значение:
//  Структура:
//   * Успешно    - Булево - сайт принял статусы.
//   * Отправлено - Число - сколько статусов отправлено.
//   * Описание   - Строка - итог или текст ошибки.
//
Функция ОтправитьСтатусы(Настройка) Экспорт

	Результат = Новый Структура("Успешно, Отправлено, Описание", Ложь, 0, "");
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Настройка", Настройка);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ОбъектыСайта.ИдНаСайте КАК ИдНаСайте,
		|	ОбъектыСайта.ОтправленныйСтатус КАК ОтправленныйСтатус,
		|	Заказы.Ссылка КАК Заказ,
		|	Заказы.Номер КАК Номер,
		|	Заказы.СуммаДокумента КАК СуммаДокумента,
		|	Заказы.СостояниеЗаказа КАК СостояниеЗаказа,
		|	ПРЕДСТАВЛЕНИЕ(Заказы.СостояниеЗаказа) КАК СостояниеПредставление,
		|	Заказы.Проведен КАК Проведен,
		|	Заказы.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	РегистрСведений.хт_ОбъектыСайта КАК ОбъектыСайта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК Заказы
		|		ПО ОбъектыСайта.Объект = Заказы.Ссылка
		|ГДЕ
		|	ОбъектыСайта.Настройка = &Настройка
		|	И ОбъектыСайта.ВидОбъекта = ""order""";
		Выборка = Запрос.Выполнить().Выбрать();

		Статусы = Новый Массив;
		Изменённые = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			Статус = СтатусДляСайта(Выборка.СостояниеЗаказа, Выборка.СостояниеПредставление,
				Выборка.Проведен, Выборка.ПометкаУдаления);
			// Сумма — тоже часть статуса: 1С могла применить скидки, покупатель должен увидеть итог по счёту.
			КлючСтатуса = Статус + "|" + Выборка.СостояниеПредставление + "|" + Формат(Выборка.СуммаДокумента, "ЧДЦ=2; ЧГ=0");
			Если КлючСтатуса = Выборка.ОтправленныйСтатус Тогда
				Продолжить;
			КонецЕсли;
			Элемент = Новый Соответствие;
			Элемент.Вставить("id", Выборка.ИдНаСайте);
			Элемент.Вставить("status", Статус);
			Элемент.Вставить("status_text", Выборка.СостояниеПредставление);
			Элемент.Вставить("ext_number", СокрЛП(Выборка.Номер));
			Элемент.Вставить("total", Выборка.СуммаДокумента);
			Статусы.Добавить(Элемент);
			Изменённые.Вставить(Выборка.ИдНаСайте, КлючСтатуса);
		КонецЦикла;

		Если Статусы.Количество() > 0 Тогда
			Данные = Новый Соответствие;
			Данные.Вставить("orders", Статусы);
			Ответ = хт_ОбменССайтом.ВыполнитьЗапросКСайту(Настройка, "POST", "/api/v1/orders/status/", Данные);
			Если Не Ответ.Успешно Тогда
				ВызватьИсключение Ответ.Описание;
			КонецЕсли;
			Для Каждого КлючИЗначение Из Изменённые Цикл
				ЗапомнитьОтправленныйСтатус(Настройка, КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЦикла;
		КонецЕсли;

		Результат.Успешно = Истина;
		Результат.Отправлено = Статусы.Количество();
		Результат.Описание = СтрШаблон("статусов отправлено %1", Статусы.Количество());
	Исключение
		Результат.Описание = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	хт_ОбменССайтом.ЗаписатьВЖурналОбмена(Настройка, "Отправка статусов", Результат.Успешно,
		Результат.Отправлено, 0, Результат.Описание);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СвязьССайтом

Функция ЗагруженныйОбъект(Настройка, ВидОбъекта, ИдНаСайте)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Настройка", Настройка);
	Запрос.УстановитьПараметр("ВидОбъекта", ВидОбъекта);
	Запрос.УстановитьПараметр("ИдНаСайте", ИдНаСайте);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбъектыСайта.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.хт_ОбъектыСайта КАК ОбъектыСайта
	|ГДЕ
	|	ОбъектыСайта.Настройка = &Настройка
	|	И ОбъектыСайта.ВидОбъекта = &ВидОбъекта
	|	И ОбъектыСайта.ИдНаСайте = &ИдНаСайте";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Объект, Неопределено);

КонецФункции

Процедура ЗапомнитьОбъект(Настройка, ВидОбъекта, ИдНаСайте, Объект, НомерНаСайте)

	Запись = РегистрыСведений.хт_ОбъектыСайта.СоздатьМенеджерЗаписи();
	Запись.Настройка = Настройка;
	Запись.ВидОбъекта = ВидОбъекта;
	Запись.ИдНаСайте = ИдНаСайте;
	Запись.Объект = Объект;
	Запись.НомерНаСайте = НомерНаСайте;
	Запись.Загружен = ТекущаяДатаСеанса();
	Запись.Записать(Истина);

КонецПроцедуры

Процедура ЗапомнитьОтправленныйСтатус(Настройка, ИдНаСайте, КлючСтатуса)

	Запись = РегистрыСведений.хт_ОбъектыСайта.СоздатьМенеджерЗаписи();
	Запись.Настройка = Настройка;
	Запись.ВидОбъекта = "order";
	Запись.ИдНаСайте = ИдНаСайте;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		Возврат;
	КонецЕсли;
	Запись.ОтправленныйСтатус = КлючСтатуса;
	Запись.Записать(Истина);

КонецПроцедуры

Функция Подтверждение(ИдНаСайте, Объект)

	Элемент = Новый Соответствие;
	Элемент.Вставить("id", ИдНаСайте);
	Элемент.Вставить("ext_id", НРег(Строка(Объект.УникальныйИдентификатор())));
	Если ТипЗнч(Объект) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Элемент.Вставить("ext_number", СокрЛП(Объект.Номер));
	Иначе
		Элемент.Вставить("ext_number", СокрЛП(Объект.Код));
	КонецЕсли;
	Возврат Элемент;

КонецФункции

Процедура ПодтвердитьПолучение(Настройка, Путь, Ключ, Подтверждения)

	Если Подтверждения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Данные = Новый Соответствие;
	Данные.Вставить(Ключ, Подтверждения);
	Ответ = хт_ОбменССайтом.ВыполнитьЗапросКСайту(Настройка, "POST", Путь, Данные);
	Если Не Ответ.Успешно Тогда
		ВызватьИсключение "Сайт не принял подтверждение получения: " + Ответ.Описание;
	КонецЕсли;

КонецПроцедуры

// Статус заказа для сайта по состоянию в УНФ. Состояния в УНФ — обычный справочник без признака этапа
// (кроме предопределённого «Завершен»), поэтому сопоставление по наименованию; само наименование
// уходит на сайт как status_text.
//
Функция СтатусДляСайта(Состояние, СостояниеПредставление, Проведен, ПометкаУдаления)

	Если ПометкаУдаления Тогда
		Возврат "canceled";
	КонецЕсли;
	Если Состояние = Справочники.СостоянияЗаказовПокупателей.Завершен
		Или СтрНайти(НРег(СостояниеПредставление), "выполн") > 0 Тогда
		Возврат "done";
	КонецЕсли;

	Имя = НРег(СостояниеПредставление);
	Если СтрНайти(Имя, "отмен") > 0 Тогда
		Возврат "canceled";
	ИначеЕсли СтрНайти(Имя, "склад") > 0 Или СтрНайти(Имя, "отгруж") > 0
		Или СтрНайти(Имя, "достав") > 0 Или СтрНайти(Имя, "выда") > 0 Тогда
		Возврат "shipping";
	ИначеЕсли СтрНайти(Имя, "обсужд") > 0 Или СтрНайти(Имя, "нов") > 0 Тогда
		Возврат "accepted";
	ИначеЕсли Проведен Или СтрНайти(Имя, "работ") > 0 Или СтрНайти(Имя, "производ") > 0
		Или СтрНайти(Имя, "подтвер") > 0 Тогда
		Возврат "confirmed";
	КонецЕсли;
	Возврат "accepted";

КонецФункции

#КонецОбласти

#Область ЗаказПокупателя

Функция СоздатьЗаказПокупателя(Настройка, Данные)

	Реквизиты = Новый Структура("ВидЦенРозница, ВидЦенОпт, Склады");
	ЗаполнитьЗначенияСвойств(Реквизиты, Настройка);
	// Подтверждённая на сайте компания покупает по оптовым ценам — заказ получает оптовый вид цен.
	ВидЦен = Реквизиты.ВидЦенРозница;
	Если Данные["price_type"] = "wholesale" И ЗначениеЗаполнено(Реквизиты.ВидЦенОпт) Тогда
		ВидЦен = Реквизиты.ВидЦенОпт;
	КонецЕсли;
	Покупатель = Данные["customer"];
	Доставка = Данные["delivery"];

	НачатьТранзакцию();
	Попытка
		Контрагент = НайтиСоздатьКонтрагента(Покупатель);

		// Порядок заполнения — как в штатной интеграции УНФ с интернет-магазином: по структуре с контрагентом
		// УНФ сама подставляет организацию, договор по умолчанию, валюту, вид цен и состояние заказа.
		Документ = Документы.ЗаказПокупателя.СоздатьДокумент();
		Документ.Дата = ТекущаяДатаСеанса();
		Документ.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу;
		Документ.Заполнить(Новый Структура("Контрагент", Контрагент));

		НачальноеСостояние = НачальноеСостояниеЗаказа();
		Если ЗначениеЗаполнено(НачальноеСостояние) Тогда
			Документ.СостояниеЗаказа = НачальноеСостояние;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Документ.Организация) Тогда
			Документ.Организация = Справочники.Организации.ОсновнаяОрганизация;
		КонецЕсли;
		Если ЗначениеЗаполнено(ВидЦен) Тогда
			Документ.ВидЦен = ВидЦен;
			Документ.СуммаВключаетНДС = ВидЦен.ЦенаВключаетНДС;
		КонецЕсли;
		Если Реквизиты.Склады.Количество() > 0 Тогда
			Документ.СтруктурнаяЕдиницаРезерв = Реквизиты.Склады[0].Склад;
		КонецЕсли;

		Документ.НомерВходящегоДокумента = Данные["number"];
		Документ.ДатаВходящегоДокумента = Документ.Дата;
		Документ.КонтактноеЛицо = СокрЛП(Покупатель["name"] + " " + Покупатель["phone"]);

		ЖелаемаяДата = ДатаИзСтроки(Доставка["date"]);
		Документ.ДатаОтгрузки = ?(ЗначениеЗаполнено(ЖелаемаяДата), ЖелаемаяДата, НачалоДня(Документ.Дата) + 86400);

		СведенияОДоставке = Новый Массив;
		Если Доставка["method"] = "truck" Тогда
			// Своя доставка: служба «Доставка собственными силами» и услуга «Доставка грузотакси».
			// Стоимость — по тарифу зоны, который сайт получил из 1С (хт_ТарифыДоставки); нет тарифа —
			// стоимость назначает менеджер при подтверждении заказа.
			Документ.СпособДоставки = Перечисления.СпособыДоставки.Курьер;
			Документ.СлужбаДоставки = Справочники.СлужбыДоставки.ДоставкаСобственнымиСилами;
			Документ.НоменклатураДоставки = УслугаДоставки();
			Документ.СтавкаНДСДоставки = Справочники.СтавкиНДС.СтавкаНДС(
				Документ.НоменклатураДоставки.ВидСтавкиНДС, Документ.Дата);
			Документ.АдресДоставки = Лев(Доставка["address"], 500);
			Документ.ЗонаТариф = ЗонаПоИд(Доставка["zone_id"]);
			Если ТипЗнч(Доставка["cost"]) = Тип("Число") Тогда
				Документ.СтоимостьДоставки = Доставка["cost"];
				РассчитатьНДСДоставки(Документ);
			КонецЕсли;
			Документ.ВремяДоставкиС = ВремяИзСтроки(Доставка["time_from"]);
			Документ.ВремяДоставкиПо = ВремяИзСтроки(Доставка["time_to"]);
			СведенияОДоставке.Добавить(ОписаниеМашины(Доставка, Данные));
			Если ТипЗнч(Доставка["cost"]) <> Тип("Число") Тогда
				СведенияОДоставке.Добавить("Стоимость доставки не рассчитана на сайте — назначить вручную.");
			КонецЕсли;
		Иначе
			Документ.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
			СведенияОДоставке.Добавить("Самовывоз: " + Доставка["store"]);
		КонецЕсли;
		Документ.ДополнительнаяИнформацияПоДоставке = СтрСоединить(СведенияОДоставке, Символы.ПС);

		Замечания = ЗаполнитьТовары(Документ, Данные["items"]);
		Замечания = Замечания + ЗамечанияПоОстаткам(Документ, Реквизиты.Склады);

		Комментарий = СтрШаблон("Заказ с сайта %1%2.", Данные["number"],
			?(Данные["price_type"] = "wholesale", " по оптовым ценам", ""));
		Если ЗначениеЗаполнено(Данные["comment"]) Тогда
			Комментарий = Комментарий + " Покупатель: " + Данные["comment"];
		КонецЕсли;
		Если ЗначениеЗаполнено(Замечания) Тогда
			Комментарий = Комментарий + Символы.ПС + Замечания;
		КонецЕсли;
		Документ.Комментарий = Комментарий;
		// Сумма с доставкой; УНФ пересчитает её так же при записи (РассчитатьСуммуДокумента).
		Документ.СуммаДокумента = Документ.Запасы.Итог("Всего") + Документ.СтоимостьДоставки
			+ ?(Документ.СуммаВключаетНДС, 0, Документ.СуммаНДСДоставки);

		// Не проводим: менеджер проверяет наличие и доставку, затем проводит заказ сам.
		Документ.Записать(РежимЗаписиДокумента.Запись);
		ЗапомнитьОбъект(Настройка, "order", Данные["id"], Документ.Ссылка, Данные["number"]);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Документ.Ссылка;

КонецФункции

// Состояние для заказа, который ещё не видел менеджер. По умолчанию УНФ ставит состояние из своих
// настроек (в демо-базе это «В производстве»), а заказу с сайта нужно «новое» состояние.
Функция НачальноеСостояниеЗаказа()
	
	Для Каждого Имя Из СтрРазделить("Новый,Новый заказ,Обсуждение КП", ",") Цикл
		Состояние = Справочники.СостоянияЗаказовПокупателей.НайтиПоНаименованию(Имя, Истина);
		Если ЗначениеЗаполнено(Состояние) Тогда
			Возврат Состояние;
		КонецЕсли;
	КонецЦикла;
	Возврат Справочники.СостоянияЗаказовПокупателей.ПустаяСсылка();
	
КонецФункции

// Услуга «Доставка грузотакси» для реквизита НоменклатураДоставки. Создаётся при первом заказе с доставкой.
Функция УслугаДоставки()
	
	Артикул = "ДОСТ-ГТ";
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &Артикул
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	// Как создание услуги в штатной интеграции УНФ с интернет-магазином.
	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
	Объект.Артикул = Артикул;
	Объект.Наименование = "Доставка грузотакси";
	Объект.НаименованиеПолное = "Доставка грузотакси «Хозтрейд»";
	Объект.КатегорияНоменклатуры = Справочники.КатегорииНоменклатуры.БезКатегории;
	Объект.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.шт;
	Объект.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Общая;
	Объект.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ОсновноеНаправление;
	Объект.ДополнительныеСвойства.Вставить("ОтключитьЗаполнениеСловаряСопоставленияНоменклатурыБЭД", Истина);
	Объект.Заполнить(Неопределено);
	Объект.Записать();
	Возврат Объект.Ссылка;
	
КонецФункции

Функция ЗаполнитьТовары(Документ, Строки)

	Ненайденные = Новый Массив;
	Для Каждого ДанныеСтроки Из Строки Цикл
		Номенклатура = НоменклатураПоИд(ДанныеСтроки["product_id"]);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Ненайденные.Добавить(СтрШаблон("%1 (%2) x %3", ДанныеСтроки["name"], ДанныеСтроки["sku"],
				Формат(ДанныеСтроки["quantity"], "ЧГ=0")));
			Продолжить;
		КонецЕсли;

		Строка = Документ.Запасы.Добавить();
		Строка.ТипНоменклатурыЗапас = Истина;
		Строка.Номенклатура = Номенклатура;
		Строка.ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
		Строка.Количество = ДанныеСтроки["quantity"];
		Строка.Цена = ДанныеСтроки["price"];
		Строка.Сумма = Строка.Количество * Строка.Цена;
		Строка.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(Номенклатура.ВидСтавкиНДС, Документ.Дата);
		РассчитатьНДССтроки(Строка, Документ);
		// Вес и объём строк — как их заполняет форма заказа; по ним УНФ и планирование рейсов считают габариты.
		Габариты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Вес, Объем");
		Строка.Вес = Строка.Количество * Габариты.Вес;
		Строка.Объем = Строка.Количество * Габариты.Объем;
	КонецЦикла;
	Документ.Вес = Документ.Запасы.Итог("Вес");
	Документ.Объем = Документ.Запасы.Итог("Объем");

	Если Ненайденные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "Не найдены в 1С, добавить вручную: " + СтрСоединить(Ненайденные, "; ") + ".";

КонецФункции

// НДС доставки — как при загрузке доставки в штатной интеграции УНФ с интернет-магазином.
Процедура РассчитатьНДСДоставки(Документ)

	Если Документ.НалогообложениеНДС <> Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС Тогда
		Документ.СуммаНДСДоставки = 0;
		Возврат;
	КонецЕсли;
	Ставка = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(Документ.СтавкаНДСДоставки);
	Документ.СуммаНДСДоставки = ?(Документ.СуммаВключаетНДС,
		Документ.СтоимостьДоставки - Документ.СтоимостьДоставки / ((Ставка + 100) / 100),
		Документ.СтоимостьДоставки * Ставка / 100);

КонецПроцедуры

// Зона доставки по ID из выгрузки доставки на сайт. Пустая ссылка — ID нет или зона удалена.
Функция ЗонаПоИд(Ид)

	Если Не ЗначениеЗаполнено(Ид) Тогда
		Возврат Справочники.ЗоныТарифыДоставки.ПустаяСсылка();
	КонецЕсли;
	Попытка
		Ссылка = Справочники.ЗоныТарифыДоставки.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
	Исключение
		Возврат Справочники.ЗоныТарифыДоставки.ПустаяСсылка();
	КонецПопытки;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Зоны.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЗоныТарифыДоставки КАК Зоны
	|ГДЕ
	|	Зоны.Ссылка = &Ссылка";
	Возврат ?(Запрос.Выполнить().Пустой(), Справочники.ЗоныТарифыДоставки.ПустаяСсылка(), Ссылка);

КонецФункции

// «Грузотакси ГАЗель Next, борт 1,5 т × 2 рейса; вес 2 400 кг, объём 1,4 м³; по тарифу 1 600 руб.»
Функция ОписаниеМашины(Доставка, Данные)

	Части = Новый Массив;
	Машина = ?(ЗначениеЗаполнено(Доставка["truck"]), Доставка["truck"],
		?(Доставка["truck_t"] = Неопределено, "", СтрШаблон("%1 т", Формат(Доставка["truck_t"], "ЧДЦ=1; ЧН=; ЧГ=0"))));
	Если ЗначениеЗаполнено(Машина) Тогда
		Рейсов = ?(ТипЗнч(Доставка["trips"]) = Тип("Число"), Доставка["trips"], 1);
		Части.Добавить("Грузотакси " + Машина + ?(Рейсов > 1, СтрШаблон(" × %1 рейс.", Рейсов), ""));
	КонецЕсли;
	Вес = СтрШаблон("вес %1 кг", Формат(Данные["weight_kg"], "ЧДЦ=0; ЧН=0; ЧГ=3,0"));
	Если ТипЗнч(Данные["volume_m3"]) = Тип("Число") И Данные["volume_m3"] > 0 Тогда
		Вес = Вес + СтрШаблон(", объём %1 м³", Формат(Данные["volume_m3"], "ЧДЦ=2; ЧГ=0"));
	КонецЕсли;
	Части.Добавить(Вес);
	Если ТипЗнч(Доставка["cost"]) = Тип("Число") Тогда
		Части.Добавить(СтрШаблон("по тарифу зоны «%1» %2 руб.", Доставка["zone"], Формат(Доставка["cost"], "ЧДЦ=0; ЧГ=3,0")));
	КонецЕсли;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Как РассчитатьСуммуНДСЗаказа в ИнтеграцияСИнтернетМагазиномСервер.
Процедура РассчитатьНДССтроки(Строка, Документ)

	Если Документ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС Тогда
		Ставка = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(Строка.СтавкаНДС);
		Строка.СуммаНДС = ?(Документ.СуммаВключаетНДС,
			Строка.Сумма - Строка.Сумма / ((Ставка + 100) / 100),
			Строка.Сумма * Ставка / 100);
	Иначе
		Строка.СуммаНДС = 0;
	КонецЕсли;
	Строка.Всего = Строка.Сумма + ?(Документ.СуммаВключаетНДС, 0, Строка.СуммаНДС);

КонецПроцедуры

// Нехватка остатков по заказу. Спрос сгруппирован по номенклатуре: одна позиция в нескольких строках
// не должна обходить проверку (сравнение с остатком — по сумме спроса, а не построчно).
//
Функция ЗамечанияПоОстаткам(Документ, Склады)

	Если Документ.Запасы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Товары", Документ.Запасы.Выгрузить(, "Номенклатура, Количество"));
	Запрос.УстановитьПараметр("Склады", Склады.ВыгрузитьКолонку("Склад"));
	Запрос.УстановитьПараметр("ВсеСклады", Склады.Количество() = 0);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_Строки
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Строки.Номенклатура КАК Номенклатура,
	|	СУММА(ВТ_Строки.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_Спрос
	|ИЗ
	|	ВТ_Строки КАК ВТ_Строки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Строки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Спрос.Номенклатура КАК Номенклатура,
	|	ВТ_Спрос.Количество КАК Спрос,
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Остаток
	|ИЗ
	|	ВТ_Спрос КАК ВТ_Спрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗапасыНаСкладах.Остатки(
	|				,
	|				Номенклатура В
	|						(ВЫБРАТЬ
	|							ВТ_Спрос.Номенклатура
	|						ИЗ
	|							ВТ_Спрос)
	|					И (&ВсеСклады
	|						ИЛИ СтруктурнаяЕдиница В (&Склады))) КАК Остатки
	|		ПО ВТ_Спрос.Номенклатура = Остатки.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Спрос.Номенклатура,
	|	ВТ_Спрос.Количество
	|
	|ИМЕЮЩИЕ
	|	ВТ_Спрос.Количество > ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0)";
	Выборка = Запрос.Выполнить().Выбрать();

	Нехватка = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Нехватка.Добавить(СтрШаблон("%1: нужно %2, на складе %3", Выборка.Номенклатура,
			Формат(Выборка.Спрос, "ЧН=0; ЧГ=0"), Формат(Выборка.Остаток, "ЧН=0; ЧГ=0")));
	КонецЦикла;

	Если Нехватка.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Символы.ПС + "Не хватает на складе: " + СтрСоединить(Нехватка, "; ") + ".";

КонецФункции

Функция НоменклатураПоИд(Ид)

	Если Не ЗначениеЗаполнено(Ид) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	Ссылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка
	|	И НЕ Номенклатура.ЭтоГруппа";
	Возврат ?(Запрос.Выполнить().Пустой(), Справочники.Номенклатура.ПустаяСсылка(), Ссылка);

КонецФункции

#КонецОбласти

#Область Контрагент

// Ищет покупателя по ИНН (организация, ИП), затем по телефону и email; не нашёл — создаёт
// так же, как штатная интеграция УНФ с интернет-магазином.
//
Функция НайтиСоздатьКонтрагента(Покупатель)

	ЭтоОрганизация = Покупатель["type"] = "company" И ЗначениеЗаполнено(Покупатель["inn"]);

	Найденный = Справочники.Контрагенты.ПустаяСсылка();
	Если ЭтоОрганизация Тогда
		Найденный = КонтрагентПоИНН(Покупатель["inn"]);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Найденный) Тогда
		Найденный = КонтрагентПоКонтактам(Покупатель["phone"], Покупатель["email"]);
	КонецЕсли;
	Если ЗначениеЗаполнено(Найденный) Тогда
		Возврат Найденный;
	КонецЕсли;

	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);
	Если ЭтоОрганизация Тогда
		Объект.Наименование = СокрЛП(Покупатель["company"]);
		Объект.НаименованиеПолное = СокрЛП(Покупатель["company"]);
		Объект.ИНН = Покупатель["inn"];
		Объект.ВидКонтрагента = ?(СтрДлина(Покупатель["inn"]) = 12,
			Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель,
			Перечисления.ВидыКонтрагентов.ЮридическоеЛицо);
	Иначе
		Объект.Наименование = СокрЛП(Покупатель["name"]);
		Объект.НаименованиеПолное = СокрЛП(Покупатель["name"]);
		Объект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ФизическоеЛицо;
	КонецЕсли;
	Объект.Покупатель = Истина;
	Объект.ВестиРасчетыПоДоговорам = Истина;
	Объект.ВестиРасчетыПоДокументам = Истина;
	Объект.ВестиРасчетыПоЗаказам = Истина;
	Объект.ВестиУчетОплатыПоСчетам = Истина;
	Объект.СчетУчетаРасчетовСПокупателем = ПланыСчетов.Управленческий.РасчетыСПокупателями;
	Объект.СчетУчетаАвансовПокупателя = ПланыСчетов.Управленческий.РасчетыПоАвансамПолученным;
	Объект.СчетУчетаРасчетовСПоставщиком = ПланыСчетов.Управленческий.РасчетыСПоставщиками;
	Объект.СчетУчетаАвансовПоставщику = ПланыСчетов.Управленческий.РасчетыПоАвансамВыданным;
	Объект.Комментарий = "Создан при загрузке заказа с сайта";

	УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Объект, ТелефонПредставление(Покупатель["phone"]),
		Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
	Если ЗначениеЗаполнено(Покупатель["email"]) Тогда
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Объект, Покупатель["email"],
			Справочники.ВидыКонтактнойИнформации.EmailКонтрагента);
	КонецЕсли;

	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция КонтрагентПоИНН(ИНН)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.ПометкаУдаления
	|	И НЕ Контрагенты.ЭтоГруппа";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.Контрагенты.ПустаяСсылка());

КонецФункции

Функция КонтрагентПоКонтактам(Телефон, Email)

	Цифры = ТолькоЦифры(Телефон);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Телефон", "%" + Прав(Цифры, 10));
	Запрос.УстановитьПараметр("ЕстьТелефон", СтрДлина(Цифры) >= 10);
	Запрос.УстановитьПараметр("Email", НРег(СокрЛП(Email)));
	Запрос.УстановитьПараметр("ЕстьEmail", ЗначениеЗаполнено(Email));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КИ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	НЕ КИ.Ссылка.ПометкаУдаления
	|	И (&ЕстьТелефон
	|				И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|				И КИ.НомерТелефона ПОДОБНО &Телефон
	|			ИЛИ &ЕстьEmail
	|				И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|				И КИ.Представление ПОДОБНО &Email)";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.Контрагенты.ПустаяСсылка());

КонецФункции

#КонецОбласти

#Область Лид

Функция СоздатьЛид(Настройка, Данные)

	ЭтоЗвонок = Данные["kind"] = "callback";

	НачатьТранзакцию();
	Попытка
		Лид = Справочники.Лиды.СоздатьЭлемент();
		Лид.Заполнить(Неопределено);
		Лид.Наименование = СокрЛП(Данные["name"]);
		Лид.Тема = ?(ЭтоЗвонок, "Обратный звонок с сайта", "Заказ по списку с сайта");

		Комментарий = Новый Массив;
		Комментарий.Добавить(СтрШаблон("Заявка с сайта №%1, телефон %2", Формат(Данные["id"], "ЧГ=0"),
			ТелефонПредставление(Данные["phone"])));
		Если ЗначениеЗаполнено(Данные["text"]) Тогда
			Комментарий.Добавить(Данные["text"]);
		КонецЕсли;
		Если Данные["file"] <> Неопределено Тогда
			Комментарий.Добавить("Файл сметы приложен: " + Данные["file"]["name"]);
		КонецЕсли;
		Лид.Комментарий = СтрСоединить(Комментарий, Символы.ПС);

		ИсточникСайт = Справочники.ИсточникиПривлеченияПокупателей.НайтиПоНаименованию("Сайт", Истина);
		Если ЗначениеЗаполнено(ИсточникСайт) Тогда
			Лид.ИсточникПривлечения = ИсточникСайт;
		КонецЕсли;

		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Лид, ТелефонПредставление(Данные["phone"]),
			Справочники.ВидыКонтактнойИнформации.ТелефонКомпанииЛида);
		Если ЗначениеЗаполнено(Данные["email"]) Тогда
			УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Лид, Данные["email"],
				Справочники.ВидыКонтактнойИнформации.EmailКомпанииЛида);
		КонецЕсли;

		Лид.Записать();

		Если Данные["file"] <> Неопределено Тогда
			ПриложитьФайлЗаявки(Настройка, Лид.Ссылка, Данные["id"], Данные["file"]["name"]);
		КонецЕсли;

		ЗапомнитьОбъект(Настройка, "lead", Данные["id"], Лид.Ссылка, "");
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Лид.Ссылка;

КонецФункции

Процедура ПриложитьФайлЗаявки(Настройка, Лид, ИдЗаявки, ИмяФайла)

	ДвоичныеДанные = хт_ОбменССайтом.ПолучитьФайлССайта(Настройка,
		СтрШаблон("/api/v1/leads/%1/file/", Формат(ИдЗаявки, "ЧГ=0")));

	Точка = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.ВладелецФайлов = Лид;
	ПараметрыФайла.ИмяБезРасширения = ?(Точка > 0, Лев(ИмяФайла, Точка - 1), ИмяФайла);
	ПараметрыФайла.РасширениеБезТочки = ?(Точка > 0, Сред(ИмяФайла, Точка + 1), "");

	РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, ПоместитьВоВременноеХранилище(ДвоичныеДанные));

КонецПроцедуры

#КонецОбласти

#Область Утилиты

Функция ТолькоЦифры(Строка)
	Результат = "";
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// +79001112233 -> +7 900 111-22-33
Функция ТелефонПредставление(Телефон)
	Цифры = Прав(ТолькоЦифры(Телефон), 10);
	Если СтрДлина(Цифры) <> 10 Тогда
		Возврат Телефон;
	КонецЕсли;
	Возврат СтрШаблон("+7 %1 %2-%3-%4", Лев(Цифры, 3), Сред(Цифры, 4, 3), Сред(Цифры, 7, 2), Прав(Цифры, 2));
КонецФункции

// "09:00" -> время 09:00 (дата 0001-01-01, как хранит время доставки УНФ). Пусто — пустая дата.
Функция ВремяИзСтроки(Строка)
	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Части = СтрРазделить(Строка, ":");
	Попытка
		Возврат Дата(1, 1, 1, Число(Части[0]), Число(Части[1]), 0);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
КонецФункции

Функция ДатаИзСтроки(Строка)
	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(СтрЗаменить(Лев(Строка, 10), "-", ""));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
КонецФункции

#КонецОбласти

