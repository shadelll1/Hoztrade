#Область ПрограммныйИнтерфейс

// Выгружает каталог на сайт по всем действующим настройкам обмена.
//
// Возвращаемое значение:
//  Строка - итог выгрузки для показа пользователю.
//
Функция ВыгрузитьКаталогНаСайт() Экспорт
	Возврат хт_ОбменССайтом.ВыгрузитьКаталогПоВсемНастройкам();
КонецФункции

// Проверяет связь с сайтом и токен обмена.
//
// Параметры:
//  Настройка - СправочникСсылка.хт_НастройкиОбменаССайтом - настройка обмена.
//
// Возвращаемое значение:
//  Строка - итог проверки для показа пользователю.
//
Функция ПроверитьСвязьССайтом(Настройка) Экспорт
	Возврат хт_ОбменССайтом.ПроверитьСвязь(Настройка).Описание;
КонецФункции

// Сохраняет токен обмена настройки в безопасном хранилище.
//
// Параметры:
//  Настройка - СправочникСсылка.хт_НастройкиОбменаССайтом - настройка обмена.
//  Токен     - Строка - новый токен; пустая строка удаляет токен.
//
Процедура ЗадатьТокенОбмена(Настройка, Токен) Экспорт
	хт_ОбменССайтом.УстановитьТокенОбмена(Настройка, Токен);
КонецПроцедуры

// Заполняет базу демо-каталогом «Хозтрейда» (группы, товары, цены, остатки, настройка обмена).
//
// Возвращаемое значение:
//  Строка - итог заполнения для показа пользователю.
//
Функция ЗаполнитьДемоКаталог() Экспорт
	Возврат хт_ДемоДанные.ЗаполнитьДемоКаталог();
КонецФункции

// Полный обмен с сайтом по всем действующим настройкам: заказы, заявки, статусы, каталог.
//
// Возвращаемое значение:
//  Строка - итог обмена для показа пользователю.
//
Функция ВыполнитьОбменССайтом() Экспорт
	Возврат хт_ОбменССайтом.ВыполнитьОбменПоВсемНастройкам();
КонецФункции

// Прикладывает к товарам картинки из папки (имя файла — артикул).
//
// Параметры:
//  Каталог  - Строка - полный путь к папке с картинками.
//  Заменять - Булево - заменить картинку и у товаров, где она уже есть.
//
// Возвращаемое значение:
//  Строка - итог для показа пользователю.
//
Функция ЗагрузитьКартинкиТоваров(Каталог, Заменять) Экспорт
	Возврат хт_ОбменССайтом.ЗагрузитьКартинкиТоваров(Каталог, Заменять);
КонецФункции

#КонецОбласти
