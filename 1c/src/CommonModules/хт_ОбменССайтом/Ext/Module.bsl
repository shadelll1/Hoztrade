#Область ЖурналОбмена

// Добавляет запись в журнал обмена с сайтом. Успешные операции, которые ничего не отправили и не получили,
// не записываются (если не указано Всегда): обмен по расписанию идёт каждые 5 минут, а в учебной версии
// в таблице не больше 2000 записей.
//
// Параметры:
//  Настройка  - СправочникСсылка.хт_НастройкиОбменаССайтом - настройка обмена.
//  Операция   - Строка - что делали: «Выгрузка каталога», «Загрузка заказов» и т.п.
//  Успешно    - Булево - операция прошла без ошибок.
//  Отправлено - Число - сколько объектов отправлено на сайт.
//  Получено   - Число - сколько объектов получено с сайта.
//  Описание   - Строка - итог или текст ошибки.
//  Всегда     - Булево - записать, даже если операция ничего не передала (проверка связи).
//
Процедура ЗаписатьВЖурналОбмена(Настройка, Операция, Успешно, Отправлено, Получено, Описание, Всегда = Ложь) Экспорт

	Если Успешно И Отправлено = 0 И Получено = 0 И Не Всегда Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.хт_ЖурналОбмена.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.Настройка = Настройка;
	Запись.Операция = Операция;
	Запись.Успешно = Успешно;
	Запись.Отправлено = Отправлено;
	Запись.Получено = Получено;
	Запись.Описание = Описание;
	Запись.Записать(Истина);

КонецПроцедуры

// Удаляет из журнала обмена записи старше 30 дней (не больше 500 за вызов). Вызывается из обмена по расписанию.
//
Процедура ОчиститьЖурналОбмена() Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - 30 * 86400);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Журнал.Период КАК Период,
	|	Журнал.Настройка КАК Настройка,
	|	Журнал.Операция КАК Операция
	|ИЗ
	|	РегистрСведений.хт_ЖурналОбмена КАК Журнал
	|ГДЕ
	|	Журнал.Период < &Граница";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.хт_ЖурналОбмена.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Удалить();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
