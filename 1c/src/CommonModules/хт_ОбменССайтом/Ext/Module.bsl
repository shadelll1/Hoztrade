// Хеши отправленных на сайт данных по настройке: Соответствие ключ -> хеш.
Функция ВерсииНаСайте(Настройка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Настройка", Настройка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Версии.Ключ КАК Ключ,
	|	Версии.Хеш КАК Хеш
	|ИЗ
	|	РегистрСведений.хт_ВерсииНаСайте КАК Версии
	|ГДЕ
	|	Версии.Настройка = &Настройка";
	Версии = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Версии.Вставить(Выборка.Ключ, Выборка.Хеш);
	КонецЦикла;
	Возврат Версии;

КонецФункции

Функция ЕстьВерсииКаталога(Версии)
	Для Каждого КлючИЗначение Из Версии Цикл
		Если СтрНачинаетсяС(КлючИЗначение.Ключ, "product:") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// После успешной выгрузки сайт совпадает с текущим каталогом: версии групп и товаров переписываются целиком
// (пропавшие удаляются). Товары с неотправленной картинкой не запоминаются — уйдут в следующий раз.
Процедура ЗаписатьВерсииКаталога(Настройка, Каталог, Неотправленные)

	Пропустить = Новый Соответствие;
	Для Каждого ИдТовара Из Неотправленные Цикл
		Пропустить.Вставить("product:" + ИдТовара, Истина);
	КонецЦикла;

	Набор = РегистрыСведений.хт_ВерсииНаСайте.СоздатьНаборЗаписей();
	Набор.Отбор.Настройка.Установить(Настройка);
	Набор.Прочитать();

	Прочие = Новый Массив;
	Для Каждого Запись Из Набор Цикл
		Если Не СтрНачинаетсяС(Запись.Ключ, "category:") И Не СтрНачинаетсяС(Запись.Ключ, "product:") Тогда
			Прочие.Добавить(Новый Структура("Ключ, Хеш, Отправлено", Запись.Ключ, Запись.Хеш, Запись.Отправлено));
		КонецЕсли;
	КонецЦикла;
	Набор.Очистить();
	Для Каждого Прочая Из Прочие Цикл
		ДобавитьВерсию(Набор, Настройка, Прочая.Ключ, Прочая.Хеш, Прочая.Отправлено);
	КонецЦикла;

	Сейчас = ТекущаяДатаСеанса();
	Для Каждого Элемент Из Каталог.Категории Цикл
		ДобавитьВерсию(Набор, Настройка, Элемент.Ключ, Элемент.Хеш, Сейчас);
	КонецЦикла;
	Для Каждого Элемент Из Каталог.Товары Цикл
		Если Пропустить[Элемент.Ключ] = Неопределено Тогда
			ДобавитьВерсию(Набор, Настройка, Элемент.Ключ, Элемент.Хеш, Сейчас);
		КонецЕсли;
	КонецЦикла;
	Набор.Записать(Истина);

КонецПроцедуры

Процедура ДобавитьВерсию(Набор, Настройка, Ключ, Хеш, Отправлено)
	Запись = Набор.Добавить();
	Запись.Настройка = Настройка;
	Запись.Ключ = Ключ;
	Запись.Хеш = Хеш;
	Запись.Отправлено = Отправлено;
КонецПроцедуры

Процедура ЗаписатьВерсию(Настройка, Ключ, Хеш)
	Запись = РегистрыСведений.хт_ВерсииНаСайте.СоздатьМенеджерЗаписи();
	Запись.Настройка = Настройка;
	Запись.Ключ = Ключ;
	Запись.Хеш = Хеш;
	Запись.Отправлено = ТекущаяДатаСеанса();
	Запись.Записать(Истина);
КонецПроцедуры

// SHA-256 строки в шестнадцатеричном виде (64 символа).
Функция Хеш(Строка)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Строка);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

