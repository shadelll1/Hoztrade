#Область ПрограммныйИнтерфейс

// Полный обмен по всем действующим настройкам: заказы и заявки с сайта, статусы заказов на сайт,
// доставка и каталог на сайт.
//
// Возвращаемое значение:
//  Строка - итог обмена по каждой настройке, для показа пользователю.
//
Функция ВыполнитьОбменПоВсемНастройкам() Экспорт

	Итог = Новый Массив;
	Для Каждого Настройка Из ДействующиеНастройки() Цикл
		Итог.Добавить(Строка(Настройка) + ":" + Символы.ПС + ВыполнитьОбмен(Настройка));
	КонецЦикла;
	Если Итог.Количество() = 0 Тогда
		Возврат "Нет действующих настроек обмена с сайтом (флажок ""Используется"").";
	КонецЕсли;
	Возврат СтрСоединить(Итог, Символы.ПС + Символы.ПС);

КонецФункции

// Полный обмен по одной настройке. Порядок: сначала забираем заказы и заявки (они важнее для
// менеджера), затем отправляем статусы, доставку, последним — каталог (самая тяжёлая часть).
// Каталог и доставка уходят, только если изменились с прошлой отправки.
//
// Параметры:
//  Настройка - СправочникСсылка.хт_НастройкиОбменаССайтом - настройка обмена.
//
// Возвращаемое значение:
//  Строка - итог обмена, по строке на каждую часть.
//
Функция ВыполнитьОбмен(Настройка) Экспорт

	// Ручной обмен и обмен по расписанию не должны идти одновременно: оба забирали бы одни и те же
	// заказы с сайта. Блокировка объекта сеансовая — снимается и при аварийном завершении сеанса.
	Попытка
		ЗаблокироватьДанныеДляРедактирования(Настройка);
	Исключение
		Описание = "обмен уже выполняется в другом сеансе, пропущен";
		ЗаписатьВЖурналОбмена(Настройка, "Обмен с сайтом", Ложь, 0, 0, Описание);
		Возврат "- " + Описание;
	КонецПопытки;

	Итог = Новый Массив;
	Попытка
		Итог.Добавить("- " + хт_ЗаказыССайта.ЗагрузитьЗаказы(Настройка).Описание);
		Итог.Добавить("- " + хт_ЗаказыССайта.ЗагрузитьЗаявки(Настройка).Описание);
		Итог.Добавить("- " + хт_ЗаказыССайта.ОтправитьСтатусы(Настройка).Описание);
		Итог.Добавить("- доставка: " + ВыгрузитьДоставку(Настройка).Описание);
		Итог.Добавить("- каталог: " + ВыгрузитьКаталог(Настройка).Описание);
	Исключение
		РазблокироватьДанныеДляРедактирования(Настройка);
		ВызватьИсключение;
	КонецПопытки;
	РазблокироватьДанныеДляРедактирования(Настройка);
	Возврат СтрСоединить(Итог, Символы.ПС);

КонецФункции

// Обработчик регламентного задания хт_ОбменССайтом: обмен по всем действующим настройкам.
// Расписание по умолчанию — каждые 5 минут, меняется в «Регламентных и фоновых заданиях».
// В файловой базе регламентные задания выполняются, только пока открыт клиентский сеанс.
//
Процедура ВыполнитьОбменПоРасписанию() Экспорт

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.хт_ОбменССайтом);
	ВыполнитьОбменПоВсемНастройкам();
	ОчиститьЖурналОбмена();

КонецПроцедуры

// Полная выгрузка каталога и доставки на сайт по всем действующим настройкам — команда «Выгрузить каталог
// на сайт». Отправляет всё, даже то, что не менялось: так восстанавливается сайт с новой или очищенной базой.
//
// Возвращаемое значение:
//  Строка - итог выгрузки по каждой настройке, для показа пользователю.
//
Функция ВыгрузитьКаталогПоВсемНастройкам() Экспорт

	Итог = Новый Массив;
	Для Каждого Настройка Из ДействующиеНастройки() Цикл
		Доставка = ВыгрузитьДоставку(Настройка, Истина);
		Результат = ВыгрузитьКаталог(Настройка, Истина);
		Итог.Добавить(СтрШаблон("%1:%2- каталог: %3%2- доставка: %4", Настройка, Символы.ПС + "  ",
			Результат.Описание, Доставка.Описание));
	КонецЦикла;

	Если Итог.Количество() = 0 Тогда
		Возврат "Нет действующих настроек обмена с сайтом (флажок ""Используется"").";
	КонецЕсли;

	Возврат СтрСоединить(Итог, Символы.ПС);

КонецФункции

// Выгружает на сайт группы, товары, цены и остатки по одной настройке обмена.
//
// Обычная выгрузка отправляет только изменённое: по каждой группе и товару (вместе с ценой, остатком и
// версией фото) хранится хеш отправленных данных (регистр хт_ВерсииНаСайте). Что пропало из выборки —
// сайт снимает с публикации по списку removed. Полная выгрузка отправляет всё, и сайт снимает с публикации
// то, чего нет в посылке. Полная выгрузка выполняется и сама, если сайт сообщает другое число товаров,
// чем в 1С (сайт развернули заново, очистили базу).
//
// Параметры:
//  Настройка - СправочникСсылка.хт_НастройкиОбменаССайтом - настройка обмена.
//  Полная    - Булево - отправить всё, а не только изменения.
//
// Возвращаемое значение:
//  Структура:
//   * Успешно    - Булево - сайт принял данные.
//   * Описание   - Строка - итог или текст ошибки.
//   * Отправлено - Число - количество отправленных товаров.
//
Функция ВыгрузитьКаталог(Настройка, Знач Полная = Ложь) Экспорт

	Результат = Новый Структура("Успешно, Описание, Отправлено", Ложь, "", 0);

	Попытка
		Каталог = ДанныеКаталога(Настройка);
		Версии = ВерсииНаСайте(Настройка);
		Полная = Полная Или Не ЕстьВерсииКаталога(Версии);

		Посылка = ПосылкаКаталога(Каталог, Версии, Полная);
		Если Посылка = Неопределено Тогда
			Результат.Успешно = Истина;
			Результат.Описание = "без изменений";
		Иначе
			Ответ = ВыполнитьЗапросКСайту(Настройка, "POST", "/api/v1/catalog/", Посылка);
			НаСайте = ТоваровНаСайте(Ответ.Данные);
			Если Ответ.Успешно И Не Полная И НаСайте >= 0 И НаСайте <> Каталог.Товары.Количество() Тогда
				Полная = Истина;
				Посылка = ПосылкаКаталога(Каталог, Версии, Истина);
				Ответ = ВыполнитьЗапросКСайту(Настройка, "POST", "/api/v1/catalog/", Посылка);
			КонецЕсли;

			Если Ответ.Успешно Тогда
				Картинки = ОтправитьКартинки(Настройка, Ответ.Данные);
				ЗаписатьВерсииКаталога(Настройка, Каталог, Картинки.Неотправленные);
				Результат.Успешно = Истина;
				Результат.Отправлено = Посылка["products"].Количество();
				Результат.Описание = ?(Полная, "полная выгрузка, ", "изменения, ") + ОписаниеОтветаКаталога(Ответ.Данные);
				Если ЗначениеЗаполнено(Картинки.Описание) Тогда
					Результат.Описание = Результат.Описание + "; " + Картинки.Описание;
				КонецЕсли;
			Иначе
				Результат.Описание = Ответ.Описание;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Результат.Описание = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ХозтрейдСайт.ВыгрузкаКаталога", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.хт_НастройкиОбменаССайтом, Настройка,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗаписатьВЖурналОбмена(Настройка, "Выгрузка каталога", Результат.Успешно,
		Результат.Отправлено, 0, Результат.Описание);

	Возврат Результат;

КонецФункции

// Выгружает на сайт зоны доставки, машины и тарифы грузотакси (регистр хт_ТарифыДоставки). На сайт
// попадают зоны и машины, у которых есть тариф. Отправляет, только если данные изменились с прошлой отправки.
//
// Параметры:
//  Настройка     - СправочникСсылка.хт_НастройкиОбменаССайтом - настройка обмена.
//  Принудительно - Булево - отправить, даже если данные не менялись.
//
// Возвращаемое значение:
//  Структура:
//   * Успешно  - Булево - сайт принял данные или отправлять было нечего.
//   * Описание - Строка - итог или текст ошибки.
//
Функция ВыгрузитьДоставку(Настройка, Принудительно = Ложь) Экспорт

	Результат = Новый Структура("Успешно, Описание", Ложь, "");
	Отправлено = 0;
	Попытка
		Данные = ДанныеДоставки();
		Хеш = Хеш(ЗаписатьВJSON(Данные));
		Если Не Принудительно И ВерсииНаСайте(Настройка)[КлючДоставки()] = Хеш Тогда
			Результат.Успешно = Истина;
			Результат.Описание = "без изменений";
		Иначе
			Ответ = ВыполнитьЗапросКСайту(Настройка, "POST", "/api/v1/delivery/", Данные);
			Если Ответ.Успешно Тогда
				ЗаписатьВерсию(Настройка, КлючДоставки(), Хеш);
				Отправлено = Данные["tariffs"].Количество();
				Результат.Успешно = Истина;
				Результат.Описание = СтрШаблон("зон %1, машин %2, тарифов %3", Данные["zones"].Количество(),
					Данные["trucks"].Количество(), Отправлено);
			Иначе
				Результат.Описание = Ответ.Описание;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Результат.Описание = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЗаписатьВЖурналОбмена(Настройка, "Выгрузка доставки", Результат.Успешно, Отправлено, 0, Результат.Описание);
	Возврат Результат;

КонецФункции

// Проверяет связь с сайтом и токен обмена.
//
// Параметры:
//  Настройка - СправочникСсылка.хт_НастройкиОбменаССайтом - настройка обмена.
//
// Возвращаемое значение:
//  Структура:
//   * Успешно  - Булево - сайт ответил и принял токен.
//   * Описание - Строка - итог или текст ошибки.
//
Функция ПроверитьСвязь(Настройка) Экспорт

	Результат = Новый Структура("Успешно, Описание", Ложь, "");
	Попытка
		Ответ = ВыполнитьЗапросКСайту(Настройка, "GET", "/api/v1/ping/");
		Результат.Успешно = Ответ.Успешно;
		Результат.Описание = ?(Ответ.Успешно, "Связь с сайтом есть", Ответ.Описание);
	Исключение
		Результат.Описание = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЗаписатьВЖурналОбмена(Настройка, "Проверка связи", Результат.Успешно, 0, 0, Результат.Описание, Истина);

	Возврат Результат;

КонецФункции

// Прикладывает к товарам картинки из папки: имя файла без расширения — артикул товара (ЦМ-500-50.jpg).
// Приложенная картинка становится основной (ФайлКартинки); на сайт она уходит при выгрузке каталога.
// Папка читается на сервере 1С — в файловой базе это тот же компьютер.
//
// Параметры:
//  Каталог  - Строка - полный путь к папке с картинками (jpg, jpeg, png, webp).
//  Заменять - Булево - Истина: заменить основную картинку и у товаров, где она уже есть.
//
// Возвращаемое значение:
//  Строка - итог для показа пользователю.
//
Функция ЗагрузитьКартинкиТоваров(Каталог, Заменять) Экспорт

	Расширения = СтрРазделить("jpg,jpeg,png,webp", ",");
	Загружено = 0;
	Пропущено = 0;
	БезТовара = Новый Массив;

	Для Каждого Файл Из НайтиФайлы(Каталог, "*", Ложь) Цикл
		Расширение = НРег(Сред(Файл.Расширение, 2));
		Если Файл.ЭтоКаталог() Или Расширения.Найти(Расширение) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Товар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Файл.ИмяБезРасширения);
		Если Не ЗначениеЗаполнено(Товар) Тогда
			БезТовара.Добавить(Файл.Имя);
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Товар.ФайлКартинки) И Не Заменять Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
		ПараметрыФайла.ВладелецФайлов = Товар;
		ПараметрыФайла.ИмяБезРасширения = Файл.ИмяБезРасширения;
		ПараметрыФайла.РасширениеБезТочки = Расширение;
		ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла,
			ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(Файл.ПолноеИмя)));

		Объект = Товар.ПолучитьОбъект();
		Объект.ФайлКартинки = ПрисоединенныйФайл;
		Объект.Записать();
		Загружено = Загружено + 1;
	КонецЦикла;

	Итог = СтрШаблон("Картинки приложены к товарам: %1. Пропущено (картинка уже есть): %2.", Загружено, Пропущено);
	Если БезТовара.Количество() > 0 Тогда
		Итог = Итог + Символы.ПС + СтрШаблон("Нет товара с таким артикулом (%1): %2", БезТовара.Количество(),
			СтрСоединить(БезТовара, ", "));
	КонецЕсли;
	Если Загружено > 0 Тогда
		Итог = Итог + Символы.ПС + "На сайт картинки уйдут при выгрузке каталога (""Выгрузить каталог на сайт"").";
	КонецЕсли;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ДанныеКаталога

// Группы и товары для сайта с хешами: по хешу выгрузка понимает, что изменилось с прошлой отправки.
//
// Возвращаемое значение:
//  Структура:
//   * Категории - Массив из Структура: Ключ, Хеш, Данные (Соответствие для JSON).
//   * Товары    - Массив из Структура: Ключ, Хеш, Товар, Цена, Остаток (Соответствия для JSON).
//   * Ключи     - Соответствие - ключи всех выгружаемых групп и товаров.
//
Функция ДанныеКаталога(Настройка)

	Реквизиты = Новый Структура("ВидЦенРозница, ВидЦенОпт, ГруппыНоменклатуры, Склады, ТолькоСЦеной");
	ЗаполнитьЗначенияСвойств(Реквизиты, Настройка);

	Группы = Реквизиты.ГруппыНоменклатуры.ВыгрузитьКолонку("Группа");
	Если Группы.Количество() = 0 Тогда
		ВызватьИсключение "В настройке обмена не указаны группы номенклатуры для сайта.";
	КонецЕсли;
	Склады = Реквизиты.Склады.ВыгрузитьКолонку("Склад");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Группы", Группы);
	Запрос.УстановитьПараметр("Склады", Склады);
	Запрос.УстановитьПараметр("ВсеСклады", Склады.Количество() = 0);
	Запрос.УстановитьПараметр("ВидЦенРозница", Реквизиты.ВидЦенРозница);
	Запрос.УстановитьПараметр("ВидЦенОпт", Реквизиты.ВидЦенОпт);
	Запрос.УстановитьПараметр("ТолькоСЦеной", Реквизиты.ТолькоСЦеной);
	Запрос.УстановитьПараметр("ПустаяХарактеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Родитель КАК Родитель,
	|	Номенклатура.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа
	|	И Номенклатура.Ссылка В ИЕРАРХИИ (&Группы)
	|	И НЕ Номенклатура.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура.Ссылка ИЕРАРХИЯ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Родитель КАК Родитель,
	|	Товары.Артикул КАК Артикул,
	|	Товары.Наименование КАК Наименование,
	|	Товары.НаименованиеПолное КАК НаименованиеПолное,
	|	ПРЕДСТАВЛЕНИЕ(Товары.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	|	Товары.Вес КАК Вес,
	|	Товары.Объем КАК Объем,
	|	ЕСТЬNULL(ЦеныРозница.Цена, 0) КАК ЦенаРозница,
	|	ЦеныОпт.Цена КАК ЦенаОпт,
	|	ЕСТЬNULL(Остатки.Количество, 0) КАК Остаток,
	|	Товары.ФайлКартинки КАК ФайлКартинки,
	|	Товары.ФайлКартинки.ДатаМодификацииУниверсальная КАК ДатаКартинки,
	|	Товары.ФайлКартинки.Размер КАК РазмерКартинки
	|ИЗ
	|	Справочник.Номенклатура КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				,
	|				ВидЦен = &ВидЦенРозница
	|					И Характеристика = &ПустаяХарактеристика) КАК ЦеныРозница
	|		ПО (ЦеныРозница.Номенклатура = Товары.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				,
	|				ВидЦен = &ВидЦенОпт
	|					И Характеристика = &ПустаяХарактеристика) КАК ЦеныОпт
	|		ПО (ЦеныОпт.Номенклатура = Товары.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЗапасыНаСкладах.Номенклатура КАК Номенклатура,
	|			СУММА(ЗапасыНаСкладах.КоличествоОстаток) КАК Количество
	|		ИЗ
	|			РегистрНакопления.ЗапасыНаСкладах.Остатки(
	|					,
	|					&ВсеСклады
	|						ИЛИ СтруктурнаяЕдиница В (&Склады)) КАК ЗапасыНаСкладах
	|
	|		СГРУППИРОВАТЬ ПО
	|			ЗапасыНаСкладах.Номенклатура) КАК Остатки
	|		ПО (Остатки.Номенклатура = Товары.Ссылка)
	|ГДЕ
	|	НЕ Товары.ЭтоГруппа
	|	И Товары.Ссылка В ИЕРАРХИИ (&Группы)
	|	И НЕ Товары.ПометкаУдаления
	|	И Товары.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
	|	И (НЕ &ТолькоСЦеной
	|			ИЛИ ЕСТЬNULL(ЦеныРозница.Цена, 0) > 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Пакет = Запрос.ВыполнитьПакет();

	ЕстьОпт = ЗначениеЗаполнено(Реквизиты.ВидЦенОпт);
	Каталог = Новый Структура("Категории, Товары, Ключи", Новый Массив, Новый Массив, Новый Соответствие);

	// Группы: выбранные в настройке корни становятся корнями каталога сайта.
	ВыгруженныеГруппы = Новый Соответствие;
	ПорядокКорней = Новый Соответствие;
	Для Индекс = 0 По Группы.ВГраница() Цикл
		ПорядокКорней.Вставить(Группы[Индекс], (Индекс + 1) * 10);
	КонецЦикла;
	// Порядок подгрупп — внутри своего родителя: новая группа меняет порядок только у соседей, а не у всего
	// каталога (иначе выгрузка изменений отправляла бы почти все группы заново).
	ПорядокВРодителе = Новый Соответствие;
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Порядок = ?(ПорядокВРодителе[Выборка.Родитель] = Неопределено, 1, ПорядокВРодителе[Выборка.Родитель] + 1);
		ПорядокВРодителе.Вставить(Выборка.Родитель, Порядок);
		ВыгруженныеГруппы.Вставить(Выборка.Ссылка, Истина);
		Элемент = Новый Соответствие;
		Элемент.Вставить("id", Идентификатор(Выборка.Ссылка));
		Элемент.Вставить("parent_id", ?(ВыгруженныеГруппы[Выборка.Родитель] = Истина,
			Идентификатор(Выборка.Родитель), Неопределено));
		Элемент.Вставить("name", Выборка.Наименование);
		Элемент.Вставить("sort", ?(ПорядокКорней[Выборка.Ссылка] = Неопределено, 1000 + Порядок,
			ПорядокКорней[Выборка.Ссылка]));
		Ключ = "category:" + Элемент["id"];
		Каталог.Категории.Добавить(Новый Структура("Ключ, Хеш, Данные", Ключ, Хеш(ЗаписатьВJSON(Элемент)), Элемент));
		Каталог.Ключи.Вставить(Ключ, Истина);
	КонецЦикла;

	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдТовара = Идентификатор(Выборка.Ссылка);

		Товар = Новый Соответствие;
		Товар.Вставить("id", ИдТовара);
		Товар.Вставить("category_id", ?(ВыгруженныеГруппы[Выборка.Родитель] = Истина,
			Идентификатор(Выборка.Родитель), Неопределено));
		Товар.Вставить("sku", СокрЛП(Выборка.Артикул));
		Товар.Вставить("name", СокрЛП(Выборка.Наименование));
		Товар.Вставить("full_name", СокрЛП(Выборка.НаименованиеПолное));
		Товар.Вставить("unit", СокрЛП(Выборка.ЕдиницаИзмерения));
		Товар.Вставить("weight_kg", ЧислоИлиНоль(Выборка.Вес));
		Товар.Вставить("volume_m3", ЧислоИлиНоль(Выборка.Объем));
		Товар.Вставить("image", ВерсияКартинки(Выборка.ФайлКартинки, Выборка.ДатаКартинки, Выборка.РазмерКартинки));

		Цена = Новый Соответствие;
		Цена.Вставить("product_id", ИдТовара);
		Цена.Вставить("retail", Выборка.ЦенаРозница);
		Цена.Вставить("wholesale", ?(ЕстьОпт И Выборка.ЦенаОпт <> NULL, Выборка.ЦенаОпт, Неопределено));

		Остаток = Новый Соответствие;
		Остаток.Вставить("product_id", ИдТовара);
		Остаток.Вставить("quantity", Макс(Выборка.Остаток, 0));

		Ключ = "product:" + ИдТовара;
		СтрокаДанных = ЗаписатьВJSON(Товар) + ЗаписатьВJSON(Цена) + ЗаписатьВJSON(Остаток);
		Каталог.Товары.Добавить(Новый Структура("Ключ, Хеш, Товар, Цена, Остаток",
			Ключ, Хеш(СтрокаДанных), Товар, Цена, Остаток));
		Каталог.Ключи.Вставить(Ключ, Истина);
	КонецЦикла;

	Возврат Каталог;

КонецФункции

// Посылка для POST /api/v1/catalog/. Неопределено — изменений нет, отправлять нечего.
Функция ПосылкаКаталога(Каталог, Версии, Полная)

	Категории = Новый Массив;
	Для Каждого Элемент Из Каталог.Категории Цикл
		Если Полная Или Версии[Элемент.Ключ] <> Элемент.Хеш Тогда
			Категории.Добавить(Элемент.Данные);
		КонецЕсли;
	КонецЦикла;

	Товары = Новый Массив;
	Цены = Новый Массив;
	Остатки = Новый Массив;
	Для Каждого Элемент Из Каталог.Товары Цикл
		Если Полная Или Версии[Элемент.Ключ] <> Элемент.Хеш Тогда
			Товары.Добавить(Элемент.Товар);
			Цены.Добавить(Элемент.Цена);
			Остатки.Добавить(Элемент.Остаток);
		КонецЕсли;
	КонецЦикла;

	// Что было на сайте, а теперь не выгружается (удалено, перенесено из выгружаемых групп, осталось без цены).
	УдаленныеКатегории = Новый Массив;
	УдаленныеТовары = Новый Массив;
	Если Не Полная Тогда
		Для Каждого КлючИЗначение Из Версии Цикл
			Ключ = КлючИЗначение.Ключ;
			Если Каталог.Ключи[Ключ] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНачинаетсяС(Ключ, "category:") Тогда
				УдаленныеКатегории.Добавить(Сред(Ключ, 10));
			ИначеЕсли СтрНачинаетсяС(Ключ, "product:") Тогда
				УдаленныеТовары.Добавить(Сред(Ключ, 9));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Не Полная И Категории.Количество() + Товары.Количество()
		+ УдаленныеКатегории.Количество() + УдаленныеТовары.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Удаленные = Новый Соответствие;
	Удаленные.Вставить("categories", УдаленныеКатегории);
	Удаленные.Вставить("products", УдаленныеТовары);

	Посылка = Новый Соответствие;
	Посылка.Вставить("full", Полная);
	Посылка.Вставить("categories", Категории);
	Посылка.Вставить("products", Товары);
	Посылка.Вставить("prices", Цены);
	Посылка.Вставить("stock", Остатки);
	Посылка.Вставить("removed", Удаленные);
	Возврат Посылка;

КонецФункции

Функция ОписаниеОтветаКаталога(Ответ)

	Если ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
		Возврат "сайт принял данные";
	КонецЕсли;

	Товары = Ответ["products"];
	Если ТипЗнч(Товары) <> Тип("Соответствие") Тогда
		Возврат "сайт принял данные";
	КонецЕсли;

	Возврат СтрШаблон("товаров новых %1, обновлено %2, снято с публикации %3, всего на сайте %4",
		Формат(Товары["created"], "ЧН=0; ЧГ=0"),
		Формат(Товары["updated"], "ЧН=0; ЧГ=0"),
		Формат(Товары["unpublished"], "ЧН=0; ЧГ=0"),
		Формат(ТоваровНаСайте(Ответ), "ЧН=0; ЧГ=0"));

КонецФункции

// Сколько товаров из 1С опубликовано на сайте после загрузки (поле total.products ответа). -1 — сайт не сообщил.
Функция ТоваровНаСайте(Ответ)
	Если ТипЗнч(Ответ) <> Тип("Соответствие") Или ТипЗнч(Ответ["total"]) <> Тип("Соответствие")
		Или ТипЗнч(Ответ["total"]["products"]) <> Тип("Число") Тогда
		Возврат -1;
	КонецЕсли;
	Возврат Ответ["total"]["products"];
КонецФункции

#КонецОбласти

#Область Картинки

// Версия картинки для сайта: сайт сверяет её с сохранённой и просит прислать только изменившиеся.
// Неопределено (null в JSON) — картинки нет, сайт удаляет ранее присланную.
Функция ВерсияКартинки(Файл, ДатаИзменения, Размер)
	Если Не ЗначениеЗаполнено(Файл) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СтрШаблон("%1-%2-%3", Идентификатор(Файл), Формат(ДатаИзменения, "ДФ=yyyyMMddHHmmss; ДП=0"),
		Формат(Размер, "ЧН=0; ЧГ=0"));
КонецФункции

// Отправляет картинки товаров, которые сайт запросил в ответе на выгрузку каталога (images_needed).
// Сбой одной картинки не прерывает выгрузку: остальные отправляются, ошибка попадает в итог, а товар
// не запоминается как отправленный — следующая выгрузка пришлёт его и картинку снова.
//
// Возвращаемое значение:
//  Структура:
//   * Описание       - Строка - итог для журнала, пустая — картинок не было.
//   * Неотправленные - Массив из Строка - ID товаров, картинки которых отправить не удалось.
//
Функция ОтправитьКартинки(Настройка, ОтветКаталога)

	Результат = Новый Структура("Описание, Неотправленные", "", Новый Массив);
	Если ТипЗнч(ОтветКаталога) <> Тип("Соответствие")
		Или ТипЗнч(ОтветКаталога["images_needed"]) <> Тип("Массив")
		Или ОтветКаталога["images_needed"].Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Отправлено = 0;
	Ошибки = Новый Массив;
	Для Каждого ИдТовара Из ОтветКаталога["images_needed"] Цикл
		Попытка
			Товар = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдТовара));
			Файл = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Товар, "ФайлКартинки");
			Если Не ЗначениеЗаполнено(Файл) Тогда
				Продолжить;
			КонецЕсли;
			Свойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Файл, "ДатаМодификацииУниверсальная, Размер");
			Версия = ВерсияКартинки(Файл, Свойства.ДатаМодификацииУниверсальная, Свойства.Размер);
			ДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(Файл);
			Путь = СтрШаблон("/api/v1/products/%1/image/?version=%2", ИдТовара,
				КодироватьСтроку(Версия, СпособКодированияСтроки.КодировкаURL));
			Ответ = ВыполнитьЗапросКСайту(Настройка, "PUT", Путь, ДанныеФайла);
			Если Ответ.Успешно Тогда
				Отправлено = Отправлено + 1;
			Иначе
				Ошибки.Добавить(Строка(Товар) + ": " + Ответ.Описание);
				Результат.Неотправленные.Добавить(ИдТовара);
			КонецЕсли;
		Исключение
			Ошибки.Добавить(ИдТовара + ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат.Неотправленные.Добавить(ИдТовара);
		КонецПопытки;
	КонецЦикла;

	Результат.Описание = "картинок отправлено " + Формат(Отправлено, "ЧН=0; ЧГ=0");
	Если Ошибки.Количество() > 0 Тогда
		Результат.Описание = Результат.Описание + ", ошибки: " + СтрСоединить(Ошибки, "; ");
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Доставка

// Зоны доставки, машины и тарифы для POST /api/v1/delivery/. Только зоны и машины, у которых есть тариф;
// зоны — по возрастанию самого дешёвого тарифа (ближние выше).
Функция ДанныеДоставки()

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Тарифы.Зона КАК Зона,
	|	Тарифы.ТранспортноеСредство КАК Машина,
	|	Тарифы.Стоимость КАК Стоимость
	|ПОМЕСТИТЬ ВТ_Тарифы
	|ИЗ
	|	РегистрСведений.хт_ТарифыДоставки КАК Тарифы
	|ГДЕ
	|	НЕ Тарифы.Зона.ПометкаУдаления
	|	И НЕ Тарифы.ТранспортноеСредство.ПометкаУдаления
	|	И Тарифы.ТранспортноеСредство.ГрузоподъемностьВТоннах > 0
	|	И Тарифы.Стоимость > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Тарифы.Зона КАК Зона,
	|	ВТ_Тарифы.Зона.Наименование КАК Наименование,
	|	ВЫРАЗИТЬ(ВТ_Тарифы.Зона.Описание КАК СТРОКА(300)) КАК Описание,
	|	МИНИМУМ(ВТ_Тарифы.Стоимость) КАК МинимальнаяСтоимость
	|ИЗ
	|	ВТ_Тарифы КАК ВТ_Тарифы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Тарифы.Зона,
	|	ВТ_Тарифы.Зона.Наименование,
	|	ВЫРАЗИТЬ(ВТ_Тарифы.Зона.Описание КАК СТРОКА(300))
	|
	|УПОРЯДОЧИТЬ ПО
	|	МинимальнаяСтоимость,
	|	Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Тарифы.Машина КАК Машина,
	|	ВТ_Тарифы.Машина.Наименование КАК Наименование,
	|	ВТ_Тарифы.Машина.ГрузоподъемностьВТоннах КАК Грузоподъемность,
	|	ВТ_Тарифы.Машина.ВместимостьВКубическихМетрах КАК Объем
	|ИЗ
	|	ВТ_Тарифы КАК ВТ_Тарифы
	|
	|УПОРЯДОЧИТЬ ПО
	|	Грузоподъемность,
	|	Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Тарифы.Зона КАК Зона,
	|	ВТ_Тарифы.Машина КАК Машина,
	|	ВТ_Тарифы.Стоимость КАК Стоимость
	|ИЗ
	|	ВТ_Тарифы КАК ВТ_Тарифы
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Тарифы.Зона.Наименование,
	|	ВТ_Тарифы.Машина.ГрузоподъемностьВТоннах";
	Пакет = Запрос.ВыполнитьПакет();

	Зоны = Новый Массив;
	Порядок = 0;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Порядок = Порядок + 10;
		Зона = Новый Соответствие;
		Зона.Вставить("id", Идентификатор(Выборка.Зона));
		Зона.Вставить("name", СокрЛП(Выборка.Наименование));
		Зона.Вставить("description", СокрЛП(Выборка.Описание));
		Зона.Вставить("sort", Порядок);
		Зоны.Добавить(Зона);
	КонецЦикла;

	Машины = Новый Массив;
	Выборка = Пакет[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Машина = Новый Соответствие;
		Машина.Вставить("id", Идентификатор(Выборка.Машина));
		Машина.Вставить("name", СокрЛП(Выборка.Наименование));
		Машина.Вставить("capacity_t", Выборка.Грузоподъемность);
		Машина.Вставить("volume_m3", ЧислоИлиНоль(Выборка.Объем));
		Машины.Добавить(Машина);
	КонецЦикла;

	Тарифы = Новый Массив;
	Выборка = Пакет[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		Тариф = Новый Соответствие;
		Тариф.Вставить("zone_id", Идентификатор(Выборка.Зона));
		Тариф.Вставить("truck_id", Идентификатор(Выборка.Машина));
		Тариф.Вставить("price", Выборка.Стоимость);
		Тарифы.Добавить(Тариф);
	КонецЦикла;

	Данные = Новый Соответствие;
	Данные.Вставить("zones", Зоны);
	Данные.Вставить("trucks", Машины);
	Данные.Вставить("tariffs", Тарифы);
	Возврат Данные;

КонецФункции

