#Область ТокенОбмена

// Сохраняет токен обмена в безопасном хранилище БСП. В справочнике токен не хранится: его не видно
// в списке и карточке настройки, в выгрузке данных и в истории изменений.
//
// Параметры:
//  Настройка - СправочникСсылка.хт_НастройкиОбменаССайтом - настройка обмена.
//  Токен     - Строка - значение EXCHANGE_TOKEN из site\.env. Пустая строка удаляет токен.
//
Процедура УстановитьТокенОбмена(Настройка, Знач Токен) Экспорт

	Если Не ПравоДоступа("Изменение", Метаданные.Справочники.хт_НастройкиОбменаССайтом) Тогда
		ВызватьИсключение "Недостаточно прав для изменения настройки обмена с сайтом.";
	КонецЕсли;
	Токен = СокрЛП(Токен);
	УстановитьПривилегированныйРежим(Истина);
	Если ЗначениеЗаполнено(Токен) Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Настройка, Токен, КлючТокена());
	Иначе
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(Настройка, КлючТокена());
	КонецЕсли;

КонецПроцедуры

// Задан ли токен обмена у настройки (само значение наружу не отдаётся).
//
// Параметры:
//  Настройка - СправочникСсылка.хт_НастройкиОбменаССайтом - настройка обмена.
//
// Возвращаемое значение:
//  Булево
//
Функция ТокенОбменаЗадан(Настройка) Экспорт
	Возврат ЗначениеЗаполнено(ТокенОбмена(Настройка));
КонецФункции

Функция ТокенОбмена(Настройка)

	УстановитьПривилегированныйРежим(Истина);
	Токен = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Настройка, КлючТокена());
	Возврат ?(ЗначениеЗаполнено(Токен), Токен, "");

КонецФункции

Функция КлючТокена()
	Возврат "ТокенОбмена";
КонецФункции

