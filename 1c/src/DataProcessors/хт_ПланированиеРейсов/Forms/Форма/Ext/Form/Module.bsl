#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// По умолчанию — завтрашние доставки: план рейсов составляют накануне.
	Если Не ЗначениеЗаполнено(ДатаДоставки) Тогда
		ДатаДоставки = НачалоДня(ТекущаяДатаСеанса()) + 86400;
	КонецЕсли;
	РаспределитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаДоставкиПриИзменении(Элемент)
	РаспределитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРейсы

&НаКлиенте
Процедура РейсыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Строка = Рейсы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.РейсыМаршрутныйЛист И ЗначениеЗаполнено(Строка.МаршрутныйЛист) Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, Строка.МаршрутныйЛист);
	ИначеЕсли Поле <> Элементы.РейсыМашина И ЗначениеЗаполнено(Строка.Заказ) Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, Строка.Заказ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РейсыМашинаПриИзменении(Элемент)

	Строка = Элементы.Рейсы.ТекущиеДанные;
	Если Строка <> Неопределено Тогда
		СменитьМашинуРейса(Строка.Рейс, Строка.Машина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Распределить(Команда)
	РаспределитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьМаршрутныеЛисты(Команда)

	Итог = СоздатьМаршрутныеЛистыНаСервере();
	Если Итог.Создано = 0 И Итог.Обновлено = 0 Тогда
		ПоказатьПредупреждение(, "Изменений нет: для всех рейсов маршрутные листы уже созданы."
			+ ?(ЗначениеЗаполнено(Итог.Проведенные), Символы.ПС + Итог.Проведенные, ""));
		Возврат;
	КонецЕсли;
	ОповеститьОбИзменении(Тип("ДокументСсылка.МаршрутныйЛист"));
	ПоказатьОповещениеПользователя("Маршрутные листы сохранены", , СтрШаблон(
		"Создано: %1, машина сменена: %2. Документы не проведены — проведите, когда машина уйдёт в рейс.",
		Итог.Создано, Итог.Обновлено));
	Если ЗначениеЗаполнено(Итог.Проведенные) Тогда
		ПоказатьПредупреждение(, Итог.Проведенные);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура РаспределитьНаСервере()

	Результат = Обработки.хт_ПланированиеРейсов.Распределить(ДатаДоставки);
	Рейсы.Очистить();
	Для Каждого Данные Из Результат.Строки Цикл
		ЗаполнитьЗначенияСвойств(Рейсы.Добавить(), Данные);
	КонецЦикла;
	Сводка = Результат.Сводка;

КонецПроцедуры

// Диспетчер поменял машину в одной строке — та же машина ставится всему рейсу, загрузка пересчитывается.
&НаСервере
Процедура СменитьМашинуРейса(Рейс, Машина)

	Строки = Рейсы.НайтиСтроки(Новый Структура("Рейс", Рейс));
	Вес = 0;
	Объем = 0;
	Для Каждого Строка Из Строки Цикл
		Вес = Вес + Строка.Вес;
		Объем = Объем + Строка.Объем;
	КонецЦикла;
	Загрузка = Обработки.хт_ПланированиеРейсов.ЗагрузкаМашины(Машина, Вес, Объем);
	Для Каждого Строка Из Строки Цикл
		Строка.Машина = Машина;
		Строка.Загрузка = Загрузка;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СоздатьМаршрутныеЛистыНаСервере()

	Строки = Новый Массив;
	Для Каждого Строка Из Рейсы Цикл
		Данные = Новый Структура("Рейс, Машина, Зона, Заказ, Вес, Объем, МаршрутныйЛист");
		ЗаполнитьЗначенияСвойств(Данные, Строка);
		Строки.Добавить(Данные);
	КонецЦикла;

	Результат = Обработки.хт_ПланированиеРейсов.СоздатьМаршрутныеЛисты(ДатаДоставки, Строки);
	Для Каждого Строка Из Рейсы Цикл
		Если Результат.Созданные[Строка.Рейс] <> Неопределено Тогда
			Строка.МаршрутныйЛист = Результат.Созданные[Строка.Рейс];
		КонецЕсли;
	КонецЦикла;

	Проведенные = "";
	Если Результат.Проведенные.Количество() > 0 Тогда
		Листы = Новый Массив;
		Для Каждого Лист Из Результат.Проведенные Цикл
			Листы.Добавить(Строка(Лист));
		КонецЦикла;
		Проведенные = "Машина не сменена в проведённых листах (сначала отмените проведение): "
			+ СтрСоединить(Листы, ", ") + ".";
	КонецЕсли;
	Возврат Новый Структура("Создано, Обновлено, Проведенные",
		Результат.Созданные.Количество(), Результат.Обновлено, Проведенные);

КонецФункции

#КонецОбласти
