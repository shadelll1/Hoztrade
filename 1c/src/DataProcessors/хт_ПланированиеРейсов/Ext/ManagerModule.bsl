#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Распределяет заказы с доставкой грузотакси на дату по машинам автопарка.
//
// Заказы берутся с отгрузкой на дату, способом доставки «Курьер» и службой «Доставка собственными силами»
// (так их создаёт загрузка заказов с сайта; так же их может оформить менеджер вручную). Заказы, уже
// включённые в маршрутный лист, остаются в своём рейсе.
//
// Остальные заказы распределяются по рейсам внутри зоны доставки и интервала времени: сначала тяжёлые,
// каждый — в первый рейс, где хватает грузоподъёмности и объёма самой большой машины; не хватает — новый рейс.
// Затем каждому рейсу назначается наименьшая машина, которая увезёт его груз. Заказы без интервала
// доставки догружаются в любой рейс своей зоны. Заказ тяжелее самой большой машины идёт отдельным
// рейсом с загрузкой больше 100 % — его нужно разбить на несколько рейсов вручную.
//
// Параметры:
//  ДатаДоставки - Дата - день доставки.
//
// Возвращаемое значение:
//  Структура:
//   * Строки  - Массив из Структура - строки для таблицы формы: Рейс, Машина, Зона, Заказ, Покупатель,
//               Адрес, Время, Вес, Объем, Загрузка, МаршрутныйЛист.
//   * Сводка  - Строка - итог для показа пользователю.
//
Функция Распределить(ДатаДоставки) Экспорт

	Машины = Автопарк();
	Заказы = ЗаказыНаДату(ДатаДоставки);

	Рейсы = Новый Массив;
	ДобавитьЗапланированныеРейсы(Рейсы, Заказы);

	НовыеРейсы = Новый Массив;
	Если Машины.Количество() > 0 Тогда
		Самая = Машины[Машины.ВГраница()];
		Нераспределенные = Заказы.НайтиСтроки(Новый Структура("МаршрутныйЛист", Документы.МаршрутныйЛист.ПустаяСсылка()));
		СИнтервалом = Новый Массив;
		БезИнтервала = Новый Массив;
		Для Каждого Заказ Из Нераспределенные Цикл
			Если ЗначениеЗаполнено(Заказ.Интервал) Тогда
				СИнтервалом.Добавить(Заказ);
			Иначе
				БезИнтервала.Добавить(Заказ);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Заказ Из СИнтервалом Цикл
			РазместитьЗаказ(НовыеРейсы, Заказ, Самая, Истина);
		КонецЦикла;
		Для Каждого Заказ Из БезИнтервала Цикл
			РазместитьЗаказ(НовыеРейсы, Заказ, Самая, Ложь);
		КонецЦикла;
		Для Каждого Рейс Из НовыеРейсы Цикл
			Рейс.Машина = НаименьшаяМашина(Машины, Рейс.Вес, Рейс.Объем);
			Рейсы.Добавить(Рейс);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура("Строки, Сводка", Новый Массив, "");
	Номер = 0;
	Перегруз = 0;
	Для Каждого Рейс Из Рейсы Цикл
		Номер = Номер + 1;
		Загрузка = ЗагрузкаМашины(Рейс.Машина, Рейс.Вес, Рейс.Объем);
		Перегруз = Перегруз + ?(Загрузка > 100, 1, 0);
		Для Каждого Заказ Из Рейс.Заказы Цикл
			Строка = Новый Структура("Рейс, Машина, Зона, Заказ, Покупатель, Адрес, Время, Вес, Объем, Загрузка, МаршрутныйЛист");
			ЗаполнитьЗначенияСвойств(Строка, Заказ);
			Строка.Рейс = Номер;
			Строка.Машина = Рейс.Машина;
			Строка.Загрузка = Загрузка;
			Результат.Строки.Добавить(Строка);
		КонецЦикла;
	КонецЦикла;

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьМаршрутныеЛисты") Тогда
		Результат.Сводка = ТекстМаршрутныеЛистыВыключены() + " ";
	КонецЕсли;
	Если Заказы.Количество() = 0 Тогда
		Результат.Сводка = Результат.Сводка + СтрШаблон("На %1 нет заказов с доставкой грузотакси.", Формат(ДатаДоставки, "ДЛФ=DD"));
	ИначеЕсли Машины.Количество() = 0 Тогда
		Результат.Сводка = Результат.Сводка + "В справочнике «Транспортные средства» нет машин с грузоподъёмностью.";
	Иначе
		Результат.Сводка = Результат.Сводка + СтрШаблон("%1: заказов %2, рейсов %3, вес %4 кг.", Формат(ДатаДоставки, "ДЛФ=DD"),
			Заказы.Количество(), Рейсы.Количество(), Формат(Заказы.Итог("Вес"), "ЧДЦ=0; ЧН=0"));
		Если Перегруз > 0 Тогда
			Результат.Сводка = Результат.Сводка + СтрШаблон(" Перегруз в рейсах: %1 — разбейте заказ на несколько рейсов.", Перегруз);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Загрузка машины в процентах — по весу или по объёму, что больше.
//
// Параметры:
//  Машина - СправочникСсылка.ТранспортныеСредства - машина рейса.
//  Вес    - Число - груз, кг.
//  Объем  - Число - груз, м³.
//
// Возвращаемое значение:
//  Число - процент загрузки, 0 — машина не указана.
//
Функция ЗагрузкаМашины(Машина, Вес, Объем) Экспорт

	Если Не ЗначениеЗаполнено(Машина) Тогда
		Возврат 0;
	КонецЕсли;
	Свойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Машина,
		"ГрузоподъемностьВТоннах, ВместимостьВКубическихМетрах");
	ПоВесу = ?(Свойства.ГрузоподъемностьВТоннах > 0, Вес / (Свойства.ГрузоподъемностьВТоннах * 1000) * 100, 0);
	ПоОбъему = ?(Свойства.ВместимостьВКубическихМетрах > 0, Объем / Свойства.ВместимостьВКубическихМетрах * 100, 0);
	Возврат Окр(Макс(ПоВесу, ПоОбъему), 0);

КонецФункции

// Создаёт маршрутные листы по рейсам, у которых их ещё нет. Документы записываются без проведения:
// проведение маршрутного листа меняет состояние заказов, это делает менеджер, когда машина уходит.
//
// Параметры:
//  ДатаДоставки - Дата - день доставки (дата документов).
//  Строки       - Массив из Структура - строки таблицы формы (Рейс, Машина, Зона, Заказ, Вес, Объем, МаршрутныйЛист).
//
// Возвращаемое значение:
//  Соответствие - номер рейса -> ДокументСсылка.МаршрутныйЛист, созданные документы.
//
Функция СоздатьМаршрутныеЛисты(ДатаДоставки, Строки) Экспорт

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьМаршрутныеЛисты") Тогда
		ВызватьИсключение ТекстМаршрутныеЛистыВыключены();
	КонецЕсли;

	Рейсы = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Если ЗначениеЗаполнено(Строка.МаршрутныйЛист) Тогда
			Продолжить;
		КонецЕсли;
		Рейс = Рейсы[Строка.Рейс];
		Если Рейс = Неопределено Тогда
			Рейс = Новый Структура("Машина, Зона, Вес, Объем, Заказы", Строка.Машина, Строка.Зона, 0, 0, Новый Массив);
			Рейсы.Вставить(Строка.Рейс, Рейс);
		КонецЕсли;
		Рейс.Вес = Рейс.Вес + Строка.Вес;
		Рейс.Объем = Рейс.Объем + Строка.Объем;
		Рейс.Заказы.Добавить(Строка.Заказ);
	КонецЦикла;

	Созданные = Новый Соответствие;
	НачатьТранзакцию();
	Попытка
		Для Каждого КлючИЗначение Из Рейсы Цикл
			Рейс = КлючИЗначение.Значение;
			Документ = Документы.МаршрутныйЛист.СоздатьДокумент();
			Документ.Дата = НачалоДня(ДатаДоставки) + 8 * 3600;
			Документ.Заполнить(Неопределено);
			Если Не ЗначениеЗаполнено(Документ.Организация) Тогда
				Документ.Организация = Справочники.Организации.ОсновнаяОрганизация;
			КонецЕсли;
			Документ.СлужбаДоставки = Справочники.СлужбыДоставки.ДоставкаСобственнымиСилами;
			Документ.СпособДоставки = Перечисления.СпособыДоставки.Курьер;
			Документ.Автомобиль = Рейс.Машина;
			Документ.ЗонаТариф = Рейс.Зона;
			Документ.ДополнительнаяИнформация = СтрШаблон("Рейс %1 на %2: заказов %3, вес %4 кг, объём %5 м³, загрузка %6",
				КлючИЗначение.Ключ, Формат(ДатаДоставки, "ДЛФ=D"), Рейс.Заказы.Количество(),
				Формат(Рейс.Вес, "ЧДЦ=0; ЧН=0"), Формат(Рейс.Объем, "ЧДЦ=2; ЧН=0"),
				Формат(ЗагрузкаМашины(Рейс.Машина, Рейс.Вес, Рейс.Объем), "ЧН=0") + " %.");
			Для Каждого Заказ Из Рейс.Заказы Цикл
				Документ.Заказы.Добавить().Заказ = Заказ;
			КонецЦикла;
			Документ.Записать(РежимЗаписиДокумента.Запись);
			Созданные.Вставить(КлючИЗначение.Ключ, Документ.Ссылка);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Созданные;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстМаршрутныеЛистыВыключены()
	Возврат "Маршрутные листы выключены: включите их в разделе Настройки — Продажи (флажок «Маршрутные листы»).";
КонецФункции

// Машины с грузоподъёмностью по возрастанию: Массив из Структура (Ссылка, Вес — кг, Объем — м³).
Функция Автопарк()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Машины.Ссылка КАК Ссылка,
	|	Машины.ГрузоподъемностьВТоннах * 1000 КАК Вес,
	|	Машины.ВместимостьВКубическихМетрах КАК Объем
	|ИЗ
	|	Справочник.ТранспортныеСредства КАК Машины
	|ГДЕ
	|	НЕ Машины.ПометкаУдаления
	|	И Машины.ГрузоподъемностьВТоннах > 0
	|	И Машины.ВидТранспортногоСредства <> ЗНАЧЕНИЕ(Перечисление.ВидыТранспортныхСредств.БуксируемоеТС)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Машины.ГрузоподъемностьВТоннах,
	|	Машины.Наименование";
	Машины = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Машины.Добавить(Новый Структура("Ссылка, Вес, Объем", Выборка.Ссылка, Выборка.Вес, Выборка.Объем));
	КонецЦикла;
	Возврат Машины;

КонецФункции

// Заказы с доставкой своим грузотакси на дату, тяжёлые первыми.
Функция ЗаказыНаДату(ДатаДоставки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(ДатаДоставки));
	Запрос.УстановитьПараметр("Конец", КонецДня(ДатаДоставки));
	Запрос.УстановитьПараметр("Служба", Справочники.СлужбыДоставки.ДоставкаСобственнымиСилами);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказы.Ссылка КАК Заказ,
	|	Заказы.ЗонаТариф КАК Зона,
	|	ПРЕДСТАВЛЕНИЕ(Заказы.Контрагент) КАК Покупатель,
	|	Заказы.АдресДоставки КАК Адрес,
	|	Заказы.ВремяДоставкиС КАК ВремяС,
	|	Заказы.ВремяДоставкиПо КАК ВремяПо,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Заказы.Вес, 0) > 0
	|			ТОГДА Заказы.Вес
	|		ИНАЧЕ ЕСТЬNULL(ГабаритыСтрок.Вес, 0)
	|	КОНЕЦ КАК Вес,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Заказы.Объем, 0) > 0
	|			ТОГДА Заказы.Объем
	|		ИНАЧЕ ЕСТЬNULL(ГабаритыСтрок.Объем, 0)
	|	КОНЕЦ КАК Объем,
	|	ЕСТЬNULL(МаршрутныеЛисты.Ссылка, ЗНАЧЕНИЕ(Документ.МаршрутныйЛист.ПустаяСсылка)) КАК МаршрутныйЛист,
	|	ЕСТЬNULL(МаршрутныеЛисты.Ссылка.Автомобиль, ЗНАЧЕНИЕ(Справочник.ТранспортныеСредства.ПустаяСсылка)) КАК Машина
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.МаршрутныйЛист.Заказы КАК МаршрутныеЛисты
	|		ПО (МаршрутныеЛисты.Заказ = Заказы.Ссылка)
	|			И (НЕ МаршрутныеЛисты.Ссылка.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Строки.Ссылка КАК Ссылка,
	|			СУММА(Строки.Количество * ВЫБОР
	|					КОГДА Строки.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|						ТОГДА Строки.ЕдиницаИзмерения.Коэффициент
	|					ИНАЧЕ 1
	|				КОНЕЦ * Строки.Номенклатура.Вес) КАК Вес,
	|			СУММА(Строки.Количество * ВЫБОР
	|					КОГДА Строки.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|						ТОГДА Строки.ЕдиницаИзмерения.Коэффициент
	|					ИНАЧЕ 1
	|				КОНЕЦ * Строки.Номенклатура.Объем) КАК Объем
	|		ИЗ
	|			Документ.ЗаказПокупателя.Запасы КАК Строки
	|		ГДЕ
	|			Строки.Ссылка.ДатаОтгрузки МЕЖДУ &Начало И &Конец
	|		СГРУППИРОВАТЬ ПО
	|			Строки.Ссылка) КАК ГабаритыСтрок
	|		ПО (ГабаритыСтрок.Ссылка = Заказы.Ссылка)
	|ГДЕ
	|	Заказы.ДатаОтгрузки МЕЖДУ &Начало И &Конец
	|	И Заказы.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.Курьер)
	|	И Заказы.СлужбаДоставки = &Служба
	|	И НЕ Заказы.ПометкаУдаления
	|	И Заказы.ВариантЗавершения <> ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Вес УБЫВ";
	Заказы = Запрос.Выполнить().Выгрузить();
	Заказы.Колонки.Добавить("Время", Новый ОписаниеТипов("Строка"));
	Заказы.Колонки.Добавить("Интервал", Новый ОписаниеТипов("Строка"));
	Для Каждого Заказ Из Заказы Цикл
		Если ЗначениеЗаполнено(Заказ.ВремяС) Или ЗначениеЗаполнено(Заказ.ВремяПо) Тогда
			Заказ.Время = Формат(Заказ.ВремяС, "ДФ=HH:mm; ДП=00:00") + "–" + Формат(Заказ.ВремяПо, "ДФ=HH:mm; ДП=24:00");
			Заказ.Интервал = Заказ.Время;
		КонецЕсли;
	КонецЦикла;
	Возврат Заказы;

КонецФункции

// Заказы из уже созданных маршрутных листов — каждый лист отдельным рейсом.
Процедура ДобавитьЗапланированныеРейсы(Рейсы, Заказы)

	ПоЛистам = Новый Соответствие;
	Для Каждого Заказ Из Заказы Цикл
		Если Не ЗначениеЗаполнено(Заказ.МаршрутныйЛист) Тогда
			Продолжить;
		КонецЕсли;
		Рейс = ПоЛистам[Заказ.МаршрутныйЛист];
		Если Рейс = Неопределено Тогда
			Рейс = НовыйРейс(Заказ);
			Рейс.Машина = Заказ.Машина;
			ПоЛистам.Вставить(Заказ.МаршрутныйЛист, Рейс);
			Рейсы.Добавить(Рейс);
		Иначе
			ДобавитьВРейс(Рейс, Заказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Первый подходящий рейс той же зоны (и того же интервала, если УчитыватьИнтервал); нет — новый рейс.
Процедура РазместитьЗаказ(Рейсы, Заказ, Самая, УчитыватьИнтервал)

	Для Каждого Рейс Из Рейсы Цикл
		Если Рейс.Зона <> Заказ.Зона Или УчитыватьИнтервал И Рейс.Интервал <> Заказ.Интервал Тогда
			Продолжить;
		КонецЕсли;
		Если Рейс.Вес + Заказ.Вес <= Самая.Вес
			И (Самая.Объем = 0 Или Рейс.Объем + Заказ.Объем <= Самая.Объем) Тогда
			ДобавитьВРейс(Рейс, Заказ);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Рейсы.Добавить(НовыйРейс(Заказ));

КонецПроцедуры

Функция НовыйРейс(Заказ)
	Рейс = Новый Структура("Машина, Зона, Интервал, Вес, Объем, Заказы",
		Справочники.ТранспортныеСредства.ПустаяСсылка(), Заказ.Зона, Заказ.Интервал, 0, 0, Новый Массив);
	ДобавитьВРейс(Рейс, Заказ);
	Возврат Рейс;
КонецФункции

Процедура ДобавитьВРейс(Рейс, Заказ)
	Рейс.Вес = Рейс.Вес + Заказ.Вес;
	Рейс.Объем = Рейс.Объем + Заказ.Объем;
	Рейс.Заказы.Добавить(Заказ);
КонецПроцедуры

// Наименьшая машина, которая увезёт груз за рейс; если такой нет — самая большая.
Функция НаименьшаяМашина(Машины, Вес, Объем)
	Для Каждого Машина Из Машины Цикл
		Если Вес <= Машина.Вес И (Машина.Объем = 0 Или Объем <= Машина.Объем) Тогда
			Возврат Машина.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Машины[Машины.ВГраница()].Ссылка;
КонецФункции

#КонецОбласти

#КонецЕсли
