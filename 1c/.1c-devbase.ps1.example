# Настройки подключения к базе. Скопировать как .1c-devbase.ps1 (в git не идёт).
# Совместим с навыком 1c-batch. Хранить в UTF-8 С BOM.

# Путь к 1cv8t.exe. Если файла нет — скрипты сами возьмут самую новую установленную учебную платформу.
$ONEC_PATH = "C:\Program Files (x86)\1c\8.5.1.1150\bin\1cv8t.exe"

# Файловая база с учебной УНФ (папка, где лежит 1Cv8.1CD)
$ONEC_FILEBASE_PATH = "C:\1c\unf_ucheb"

# Имя расширения в базе
$EXT_NAME = "ХозтрейдСайт"

# Пользователь базы. Если при запуске УНФ появляется выбор пользователя — впишите его имя
# (например "Администратор"), иначе пакетный запуск не сможет войти. Пароли учебная версия не поддерживает.
$ONEC_USER     = ""
$ONEC_PASSWORD = ""
