# Настройки боевого стенда (docker compose). Скопировать в deploy/.env и заполнить. В git не попадает.

# Домен сайта. Кириллический — в punycode: хозтрейд.рф = xn--d1abfjwnnv.xn--p1ai
SITE_DOMAIN=xn--d1abfjwnnv.xn--p1ai

# Длинные случайные строки: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
EXCHANGE_TOKEN=
POSTGRES_PASSWORD=

# HSTS: браузер ходит только по HTTPS столько секунд. Начать с часа, после недели без проблем — 31536000 (год).
# Поддомены и preload — только если все поддомены тоже на HTTPS: отменить это потом долго.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Почта: SMTP одной строкой, отправитель, кому писать о заказах и об ошибках сайта
EMAIL_URL=smtp+ssl://shop%40example.ru@smtp.example.ru:465
# Пароль ящика — отдельно, в одинарных кавычках (иначе compose подставит переменные вместо $)
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=shop@example.ru
MANAGER_EMAILS=manager@example.ru
ADMIN_EMAILS=admin@example.ru

# Telegram (по желанию): токен бота от @BotFather и чат менеджеров
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
